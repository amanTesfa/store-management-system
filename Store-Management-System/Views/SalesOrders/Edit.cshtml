@model SalesOrderViewModel

@{
    ViewData["Title"] = "Edit Sales Order";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Edit Sales Order</h1>
    <span class="badge bg-dark text-white ms-2">@Model.VoucherNumber</span>
</div>

<form id="mainForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="VoucherNumber" />
    <input type="hidden" asp-for="Status" />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="VoucherNumber" class="form-label">SO Number</label>
                        <input asp-for="VoucherNumber" class="form-control" readonly style="background-color: #e9ecef;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label">Customer *</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarehouseId" class="form-label">Shipping Warehouse *</label>
                        <select asp-for="WarehouseId" class="form-select" asp-items="Model.Warehouses">
                            <option value="">-- Select Warehouse --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DeliveryDate" class="form-label">Requested Delivery Date</label>
                        <input asp-for="DeliveryDate" class="form-control" type="date" />
                        <span asp-validation-for="DeliveryDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label">Shipping Address</label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
                        <small class="text-muted">Leave empty to use customer's default address</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BillingAddress" class="form-label">Billing Address</label>
                        <textarea asp-for="BillingAddress" class="form-control" rows="2"></textarea>
                        <small class="text-muted">Leave empty to use customer's default address</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Pricing & Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Tax Rate (%)</label>
                            <input asp-for="TaxRate" class="form-control" type="number" step="0.01" value="@Model.TaxRate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Discount Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" value="@Model.DiscountAmount" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Shipping Charge</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="ShippingCharge" class="form-control" type="number" step="0.01" value="@Model.ShippingCharge" />
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Subtotal:</strong>
                        <span id="subtotalDisplay">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Discount:</strong>
                        <span id="discountDisplay">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Tax:</strong>
                        <span id="taxDisplay">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Shipping:</strong>
                        <span id="shippingDisplay">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between fs-5">
                        <strong>Grand Total:</strong>
                        <strong id="grandTotalDisplay">$0.00</strong>
                    </div>
                </div>
            </div>

            @if (Model.Status == "Draft")
            {
                <div class="alert alert-info mt-3">
                    <i class="align-middle" data-feather="info"></i>
                    <strong>Note:</strong> Stock will be reserved when you approve this order.
                </div>
            }
        </div>
    </div>

    <!-- Line Items -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Products</h5>
            <button type="button" class="btn btn-sm btn-primary" onclick="addLine()">
                <i class="align-middle" data-feather="plus"></i> Add Product
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive table-scrollable">
                <table class="table table-bordered mb-0" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="35%">Product</th>
                            <th width="15%">Quantity</th>
                            <th width="15%">Unit Price</th>
                            <th width="10%">Discount %</th>
                            <th width="15%">Line Total</th>
                            <th width="10%">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            <tr class="line-item" data-index="@i">
                                <td>
                                    <select name="Lines[@i].ArticleId" class="form-select product-select" data-index="@i" onchange="updateLineTotal(@i)">
                                        <option value="">-- Select Product --</option>
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.Value" selected="@(line.ArticleId.ToString() == product.Value)">
                                                @product.Text
                                            </option>
                                        }
                                    </select>
                                    @if (!line.IsStockSufficient && line.Quantity > 0)
                                    {
                                        <small class="text-danger">⚠️ Insufficient stock! Available: @line.AvailableStock</small>
                                    }
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].Quantity" class="form-control quantity" step="0.01" value="@line.Quantity" onchange="updateLineTotal(@i)" />
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].UnitPrice" class="form-control unit-price" step="0.01" value="@line.UnitPrice" onchange="updateLineTotal(@i)" />
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].DiscountPercent" class="form-control discount" step="0.01" value="@line.DiscountPercent" onchange="updateLineTotal(@i)" />
                                </td>
                                <td class="line-total-@i text-end fw-bold">$0.00</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-danger" onclick="removeLine(this)">
                                        <i class="align-middle" data-feather="x"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
        <div>
            @if (Model.Status == "Draft")
            {
                <button type="submit" class="btn btn-primary">
                    <i class="align-middle" data-feather="save"></i> Save Changes
                </button>
            }
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        var lineCounter = @Model.Lines.Count;

        function addLine() {
            var index = lineCounter;
            var newRow = `
                <tr class="line-item" data-index="${index}">
                     <td>
                        <select name="Lines[${index}].ArticleId" class="form-select product-select" data-index="${index}" onchange="updateLineTotal(${index})">
                            <option value="">-- Select Product --</option>
                            @foreach (var product in Model.Products)
                            {
                                    <option value="@product.Value">@product.Text</option>
                            }
                        </select>
                     </td>
                     <td>
                        <input type="number" name="Lines[${index}].Quantity" class="form-control quantity" step="0.01" onchange="updateLineTotal(${index})" />
                     </td>
                     <td>
                        <input type="number" name="Lines[${index}].UnitPrice" class="form-control unit-price" step="0.01" onchange="updateLineTotal(${index})" />
                     </td>
                     <td>
                        <input type="number" name="Lines[${index}].DiscountPercent" class="form-control discount" step="0.01" onchange="updateLineTotal(${index})" />
                     </td>
                    <td class="line-total-${index} text-end fw-bold">$0.00</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeLine(this)">
                            <i class="align-middle" data-feather="x"></i>
                        </button>
                     </td>
                 </tr>
            `;
            $('#itemsBody').append(newRow);
            lineCounter++;
            updateSummary();
        }

        function removeLine(btn) {
            $(btn).closest('tr.line-item').remove();
            updateSummary();
        }

        function updateLineTotal(index) {
            var quantity = parseFloat($(`input[name="Lines[${index}].Quantity"]`).val()) || 0;
            var unitPrice = parseFloat($(`input[name="Lines[${index}].UnitPrice"]`).val()) || 0;
            var discount = parseFloat($(`input[name="Lines[${index}].DiscountPercent"]`).val()) || 0;
            var lineTotal = quantity * unitPrice * (1 - discount / 100);
            $(`.line-total-${index}`).text('$' + lineTotal.toFixed(2));
            updateSummary();
        }

        function updateSummary() {
            var subtotal = 0;
            $('.line-item').each(function() {
                var total = parseFloat($(this).find('.line-total').text().replace('$', '')) || 0;
                subtotal += total;
            });

            var discount = parseFloat($('#DiscountAmount').val()) || 0;
            var taxRate = parseFloat($('#TaxRate').val()) || 0;
            var shipping = parseFloat($('#ShippingCharge').val()) || 0;

            var afterDiscount = subtotal - discount;
            var tax = afterDiscount * taxRate / 100;
            var grandTotal = afterDiscount + tax + shipping;

            $('#subtotalDisplay').text('$' + subtotal.toFixed(2));
            $('#discountDisplay').text('$' + discount.toFixed(2));
            $('#taxDisplay').text('$' + tax.toFixed(2));
            $('#shippingDisplay').text('$' + shipping.toFixed(2));
            $('#grandTotalDisplay').text('$' + grandTotal.toFixed(2));
        }

        $(document).ready(function() {
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                    <text>updateLineTotal(@i);</text>
            }
            updateSummary();

            $('#DiscountAmount, #TaxRate, #ShippingCharge').on('input', function() {
                updateSummary();
            });
        });
    </script>
}