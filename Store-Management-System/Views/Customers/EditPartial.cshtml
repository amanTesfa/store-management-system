@model CustomerEditViewModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Edit Customer</h5>
        <button type="button" class="btn btn-sm btn-secondary" onclick="loadCustomerDetails(@Model.Id)">
            <i class="align-middle" data-feather="arrow-left"></i> Back to Details
        </button>
    </div>
    <div class="card-body" style="max-height: calc(100vh - 250px); overflow-y: auto;">
        <form id="editCustomerForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ConsigneeCode" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CurrentBalance" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Customer Type Selection -->
            <div class="mb-3">
                <label asp-for="ConsigneeType" class="form-label" readonly>Customer Type *</label>
                <select asp-for="ConsigneeType" class="form-select" id="ConsigneeType">
                    <option value="">-- Select Type --</option>
                    <option value="Individual" selected="@(Model.ConsigneeType == "Individual")">Individual</option>
                    <option value="Organization" selected="@(Model.ConsigneeType == "Organization")">Organization</option>
                </select>
                <span asp-validation-for="ConsigneeType" class="text-danger small"></span>
            </div>

            <!-- Common Fields -->
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label">Display Name *</label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Mobile" class="form-label">Mobile</label>
                <input asp-for="Mobile" class="form-control" />
                <span asp-validation-for="Mobile" class="text-danger small"></span>
            </div>

            <!-- Organization Fields -->
            <div class="org-fields" style="display: @(Model.ConsigneeType == "Organization" ? "block" : "none");">
                <hr />
                <h6 class="mb-3">Organization Information</h6>

                <div class="mb-3">
                    <label asp-for="TIN" class="form-label">TIN (Tax ID)</label>
                    <input asp-for="TIN" class="form-control" />
                    <span asp-validation-for="TIN" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Industry" class="form-label">Industry</label>
                            <select asp-for="Industry" class="form-select" asp-items="Model.Industries">
                                <option value="">-- Select Industry --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="NumberOfEmployees" class="form-label">Number of Employees</label>
                            <input asp-for="NumberOfEmployees" class="form-control" type="number" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="AnnualRevenue" class="form-label">Annual Revenue</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="AnnualRevenue" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Website" class="form-label">Website</label>
                            <input asp-for="Website" class="form-control" type="url" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactPerson" class="form-label">Contact Person</label>
                    <input asp-for="ContactPerson" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ParentCompanyId" class="form-label">Parent Company</label>
                    <select asp-for="ParentCompanyId" class="form-select" asp-items="Model.ParentCompanies">
                        <option value="">-- None --</option>
                    </select>
                </div>
            </div>

            <!-- Individual Fields -->
            <div class="individual-fields" style="display: @(Model.ConsigneeType == "Individual" ? "block" : "none");">
                <hr />
                <h6 class="mb-3">Personal Information</h6>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select" asp-items="Model.Genders">
                                <option value="">-- Select Gender --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="NationalId" class="form-label">National ID</label>
                            <input asp-for="NationalId" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Occupation" class="form-label">Occupation</label>
                            <input asp-for="Occupation" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <hr />
            <h6 class="mb-3">Address Information</h6>

            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label">Shipping Address</label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="BillingAddress" class="form-label">Billing Address</label>
                <textarea asp-for="BillingAddress" class="form-control" rows="2"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="State" class="form-label">State/Province</label>
                        <input asp-for="State" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PostalCode" class="form-label">Postal Code</label>
                        <input asp-for="PostalCode" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Country" class="form-label">Country</label>
                        <input asp-for="Country" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Financial Information -->
            <hr />
            <h6 class="mb-3">Financial Information</h6>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="TaxNumber" class="form-label">Tax Number (VAT)</label>
                        <input asp-for="TaxNumber" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PaymentTerms" class="form-label">Payment Terms</label>
                        <input asp-for="PaymentTerms" class="form-control" placeholder="e.g., Net 30" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="CreditLimit" class="form-label">Credit Limit</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CreditLimit" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PriceLevel" class="form-label">Price Level</label>
                        <select asp-for="PriceLevel" class="form-select" asp-items="Model.PriceLevels">
                            <option value="">-- Select Price Level --</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Reserved Fields -->
            <hr />
            <div class="mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="$('#reservedFields').toggleClass('d-none')">
                    <i class="align-middle" data-feather="more-horizontal"></i> Reserved Fields (Future Use)
                </button>
            </div>
            <div id="reservedFields" class="d-none">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Reserved1" class="form-label">Reserved 1</label>
                            <input asp-for="Reserved1" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Reserved2" class="form-label">Reserved 2</label>
                            <input asp-for="Reserved2" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Reserved3" class="form-label">Reserved 3</label>
                            <input asp-for="Reserved3" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Reserved4" class="form-label">Reserved 4</label>
                            <input asp-for="Reserved4" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Reserved5" class="form-label">Reserved 5</label>
                    <input asp-for="Reserved5" class="form-control" />
                </div>
            </div>

            <!-- Active Status -->
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                    <label asp-for="IsActive" class="form-check-label">Active Customer</label>
                </div>
            </div>

            <!-- System Information -->
            <hr />
            <div class="alert alert-info">
                <i class="align-middle" data-feather="info"></i>
                <strong>System Information</strong>
                <hr class="my-2" />
                <div class="row">
                    <div class="col-md-6">
                        <small>Customer Code: <code>@Model.ConsigneeCode</code></small><br />
                        <small>Customer Since: @(Model.CustomerSince?.ToString("MMM dd, yyyy") ?? Model.CreatedAt.ToString("MMM dd, yyyy"))</small><br />
                        <small>Created At: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    <div class="col-md-6">
                        <small>Current Balance: <strong class="@(Model.CurrentBalance > 0 ? "text-danger" : "text-success")">@Model.CurrentBalance.ToString("C")</strong></small><br />
                        <small>Available Credit: @((Model.CreditLimit ?? 0 - Model.CurrentBalance).ToString("C"))</small><br />
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <small>Last Updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" onclick="loadCustomerDetails(@Model.Id)">
                    <i class="align-middle" data-feather="x"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary" onclick="event.preventDefault(); submitEditForm();">
                    <i class="align-middle" data-feather="save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    feather.replace();

    // Toggle fields when customer type changes
    $(document).ready(function() {
        $('#ConsigneeType').on('change', function() {
            var type = $(this).val();
            if (type === 'Individual') {
                $('.org-fields').hide();
                $('.individual-fields').show();
            } else if (type === 'Organization') {
                $('.org-fields').show();
                $('.individual-fields').hide();
            } else {
                $('.org-fields').hide();
                $('.individual-fields').hide();
            }
        });
    });
</script>