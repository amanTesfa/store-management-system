@{
    ViewData["Title"] = "Import Beginning Balance";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Import Beginning Balance</h1>
    <span class="badge bg-dark text-white ms-2">Bulk Import</span>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Upload Card -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Upload File</h5>
            </div>
            <div class="card-body">
                <form asp-action="Import" method="post" enctype="multipart/form-data" id="importForm">
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Fiscal Period *</label>
                            <select name="fiscalPeriodId" class="form-select" id="fiscalPeriodSelect" asp-items="ViewBag.FiscalPeriods">
                                <option value="">-- Select Fiscal Period --</option>
                            </select>
                            <small class="text-muted">All lines will be imported to this fiscal period.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description (Optional)</label>
                            <input type="text" name="description" class="form-control" placeholder="e.g., Q1 2026 Opening Stock" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select CSV or Excel File *</label>
                        <input type="file" name="file" class="form-control" id="importFile"
                               accept=".csv,.xlsx,.xls" />
                        <small class="text-muted">Max file size: 10MB</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-info" id="previewBtn">
                            <i class="align-middle" data-feather="eye"></i> Preview Data
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="align-middle" data-feather="upload"></i> Import Beginning Balance
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="align-middle" data-feather="arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Preview Card -->
        <div class="card mt-3" id="previewCard" style="display: none;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Data Preview</h5>
                <span class="badge bg-info" id="previewCount"></span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive table-scrollable" style="max-height: 400px;">
                    <table class="table table-bordered mb-0 table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Article Code</th>
                                <th>Article Name</th>
                                <th>Warehouse</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Total</th>
                                <th>Batch</th>
                                <th>Expiry</th>
                                <th>Valid</th>
                            </tr>
                        </thead>
                        <tbody id="previewBody">
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    Upload a file and click "Preview Data" to see content.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Instructions Card -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="align-middle" data-feather="info"></i> Instructions
                </h5>
            </div>
            <div class="card-body">
                <h6>Required Columns:</h6>
                <ul class="small">
                    <li><strong>Article Code</strong> or <strong>Article Name</strong> - Product identifier</li>
                    <li><strong>Warehouse Code</strong> - Warehouse to assign stock</li>
                    <li><strong>Quantity</strong> - Opening stock quantity</li>
                    <li><strong>Unit Cost</strong> - Cost per unit</li>
                </ul>

                <h6>Optional Columns:</h6>
                <ul class="small">
                    <li><strong>Batch Number</strong> - Batch/Lot number</li>
                    <li><strong>Serial Number</strong> - Serial number</li>
                    <li><strong>Expiry Date</strong> - Expiry date (YYYY-MM-DD)</li>
                    <li><strong>Notes</strong> - Additional notes</li>
                </ul>

                <hr />

                <h6>Sample CSV Format:</h6>
                <div class="bg-light p-2 rounded small" style="font-family: monospace; font-size: 11px;">
                    Article Code,Article Name,Warehouse Code,Quantity,Unit Cost,Batch Number,Expiry Date,Notes<br />
                    ART-2704-0001,,WH-001,100,15.50,BATCH-001,2026-12-31,<br />
                    ,Wireless Mouse,WH-001,50,12.00,,,Initial stock
                </div>

                <div class="mt-3">
                    <a asp-action="DownloadSample" class="btn btn-sm btn-outline-primary">
                        <i class="align-middle" data-feather="download"></i> Download Sample CSV
                    </a>
                </div>
            </div>
        </div>

        <!-- Tips Card -->
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Tips</h5>
            </div>
            <div class="card-body small">
                <ul class="mb-0">
                    <li>Use <strong>Article Code</strong> for exact matching</li>
                    <li>If Article Code is blank, system matches by <strong>Article Name</strong></li>
                    <li>Warehouse Code must match existing warehouse codes</li>
                    <li>Import creates a <strong>Draft</strong> balance</li>
                    <li>You can <strong>Approve</strong> then <strong>Post</strong> after importing</li>
                    <li>Posting updates actual inventory levels</li>
                    <li>Save Excel files as <strong>.csv</strong> for best compatibility</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set default fiscal period
        $(document).ready(function() {
            var defaultPeriodId = '@ViewBag.DefaultFiscalPeriodId';
            if (defaultPeriodId && defaultPeriodId !== '0') {
                $('#fiscalPeriodSelect').val(defaultPeriodId);
            }
        });

        // File validation
        $('#importFile').on('change', function() {
            var file = this.files[0];
            if (file) {
                var extension = file.name.split('.').pop().toLowerCase();
                if (extension !== 'csv' && extension !== 'xlsx' && extension !== 'xls') {
                    alert('Please select a CSV or Excel file (.csv, .xlsx, .xls)');
                    $(this).val('');
                    return;
                }
                if (file.size > 10 * 1024 * 1024) {
                    alert('File size exceeds 10MB limit.');
                    $(this).val('');
                    return;
                }
            }
        });

        // Preview functionality
        $('#previewBtn').on('click', function() {
            var fileInput = $('#importFile')[0];
            if (!fileInput.files || !fileInput.files[0]) {
                alert('Please select a file first.');
                return;
            }

            var formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            $('#loadingSpinner').fadeIn(200);

            $.ajax({
                url: '@Url.Action("PreviewImport", "BeginningBalance")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    if (response.success) {
                        displayPreview(response);
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    $('#loadingSpinner').fadeOut(200);
                    alert('Error previewing file.');
                }
            });
        });

        function displayPreview(data) {
            $('#previewCard').show();
            $('#previewCount').text(data.totalRows + ' total rows (showing first ' + data.previewCount + ')');

            var html = '';
            data.preview.forEach(function(row) {
                var validIcon = row.isValid
                    ? '<span class="badge bg-success">✓</span>'
                    : '<span class="badge bg-danger">✗</span>';
                html += `
                    <tr>
                        <td>${row.row}</td>
                        <td><code>${row.articleCode || '<span class="text-muted">-</span>'}</code></td>
                        <td>${row.articleName || '<span class="text-muted">-</span>'}</td>
                        <td>${row.warehouseCode || '<span class="text-danger">Missing</span>'}</td>
                        <td class="text-end">${row.quantity}</td>
                        <td class="text-end">$${row.unitCost.toFixed(2)}</td>
                        <td class="text-end fw-bold">$${row.totalValue.toFixed(2)}</td>
                        <td>${row.batchNumber || '-'}</td>
                        <td>${row.expiryDate || '-'}</td>
                        <td>${validIcon}</td>
                    </tr>
                `;
            });

            $('#previewBody').html(html);
        }
    </script>
}