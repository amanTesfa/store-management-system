@model BeginningBalanceViewModel

@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Beginning Balance" : "New Beginning Balance";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">@(Model.Id > 0 ? "Edit" : "New") Beginning Balance</h1>
    <span class="badge bg-dark text-white ms-2">@Model.Status</span>
</div>

<form id="mainForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BalanceNumber" />
    <input type="hidden" asp-for="Status" />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Balance Information</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="BalanceNumber" class="form-label">Balance Number</label>
                        <input asp-for="BalanceNumber" class="form-control" readonly style="background-color: #e9ecef;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FiscalPeriodId" class="form-label">Fiscal Period *</label>
                        <select asp-for="FiscalPeriodId" class="form-select" asp-items="Model.FiscalPeriods">
                            <option value="">-- Select Period --</option>
                        </select>
                        <span asp-validation-for="FiscalPeriodId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarehouseId" class="form-label">De fault Warehouse</label>
                        <select asp-for="WarehouseId" class="form-select" asp-items="Model.Warehouses">
                            <option value="">-- Select Warehouse --</option>
                        </select>
                        <small class="text-muted d-block">Can be overridden per line item</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="e.g., Initial stock as of Jan 1, 2024"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Summary</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th>Total Items:</th>
                            <td class="text-end" id="totalItemsDisplay">0</td>
                        </tr>
                        <tr>
                            <th>Total Quantity:</th>
                            <td class="text-end" id="totalQuantityDisplay">0</td>
                        </tr>
                        <tr>
                            <th>Total Value:</th>
                            <td class="text-end fw-bold" id="totalValueDisplay">$0.00</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.Id > 0 && Model.Status != "Draft")
            {
                <div class="alert alert-warning mt-3">
                    <i class="align-middle" data-feather="alert-circle"></i>
                    This balance is <strong>@Model.Status</strong> and cannot be modified.
                </div>
            }
        </div>
    </div>

    <!-- Line Items -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Line Items</h5>
            @if (Model.Status == "Draft")
            {
                <button type="button" class="btn btn-sm btn-primary" onclick="addLine()">
                    <i class="align-middle" data-feather="plus"></i> Add Product
                </button>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Warehouse</th>
                            <th width="100">Quantity</th>
                            <th width="120">Unit Cost</th>
                            <th width="120">Total</th>
                            <th width="80">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            <tr class="line-item" data-index="@i">
                                <td>
                                    <select name="Lines[@i].ArticleId" class="form-select product-select" required data-index="@i" onchange="loadProductDetails(this, @i)" @(Model.Status != "Draft" ? "disabled" : "")>
                                        <option value="">-- Select Product --</option>
                                        @foreach (var article in Model.Articles)
                                        {
                                            <option value="@article.Value" selected="@(line.ArticleId.ToString() == article.Value)">
                                                @article.Text
                                            </option>
                                        }
                                    </select>
                                    <div class="product-details-@i small text-muted mt-1"></div>
                                </td>
                                <td>
                                    <select name="Lines[@i].WarehouseId" class="form-select" @(Model.Status != "Draft" ? "disabled" : "")>
                                        <option value="">-- Default --</option>
                                        @foreach (var wh in Model.Warehouses)
                                        {
                                            <option value="@wh.Value" selected="@(line.WarehouseId?.ToString() == wh.Value)">
                                                @wh.Text
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].Quantity" class="form-control quantity" step="0.01" value="@(line.Quantity > 0 ? line.Quantity.ToString() : "")" onchange="updateLineTotal(@i)" @(Model.Status != "Draft" ? "disabled" : "") />
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].UnitCost" class="form-control unit-cost" step="0.01" value="@(line.UnitCost > 0 ? line.UnitCost.ToString() : "")" onchange="updateLineTotal(@i)" @(Model.Status != "Draft" ? "disabled" : "") />
                                </td>
                                <td class="line-total-@i text-end fw-bold">$0.00</td>
                                <td class="text-center">
                                    @if (Model.Status == "Draft")
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" onclick="removeLine(this)">
                                            <i class="align-middle" data-feather="x"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            <tr id="tracking-row-@i" class="tracking-row" style="display:none;">
                                <td colspan="6" class="bg-light">
                                    <div class="row p-2">
                                        <div class="col-md-4">
                                            <label class="form-label small">Batch/Lot Number</label>
                                            <input type="text" name="Lines[@i].BatchNumber" class="form-control form-control-sm" value="@line.BatchNumber" @(Model.Status != "Draft" ? "disabled" : "") />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Serial Number</label>
                                            <input type="text" name="Lines[@i].SerialNumber" class="form-control form-control-sm" value="@line.SerialNumber" @(Model.Status != "Draft" ? "disabled" : "") />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Expiry Date</label>
                                            <input type="date" name="Lines[@i].ExpiryDate" class="form-control form-control-sm" value="@(line.ExpiryDate?.ToString("yyyy-MM-dd"))" @(Model.Status != "Draft" ? "disabled" : "") />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
        <div>
            @if (Model.Status == "Draft")
            {
                <button type="submit" class="btn btn-primary" name="action" value="save">
                    <i class="align-middle" data-feather="save"></i> Save Draft
                </button>
            }
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
                function validateNoDuplicates() {
            var seen = new Set();
            var hasDuplicate = false;
            var duplicateNames = [];

            $('.line-item').each(function() {
                var articleId = $(this).find('.product-select').val();
                var warehouseId = $(this).find('select[name$=".WarehouseId"]').val() || $('#WarehouseId').val();

                if (articleId) {
                    var key = articleId + '_' + warehouseId;
                    if (seen.has(key)) {
                        hasDuplicate = true;
                        var productName = $(this).find('.product-select option:selected').text();
                        duplicateNames.push(productName);
                    }
                    seen.add(key);
                }
            });

            if (hasDuplicate) {
                alert('Duplicate products found: ' + duplicateNames.join(', ') + '. Please combine quantities into one line per product per warehouse.');
                return false;
            }
            return true;
        }

        // Call this before form submission
        $('#mainForm').on('submit', function(e) {
            if (!validateNoDuplicates()) {
                e.preventDefault();
                return false;
            }
        });

                $(document).ready(function() {
            $('#mainForm').on('submit', function() {
                if (!validateNoDuplicates()) {
            e.preventDefault();
            return false;
        }
                // Clean up decimal values before submit
                $('.quantity, .unit-cost').each(function() {
                    var val = $(this).val();
                    if (val) {
                        // Remove trailing zeros and ensure dot as decimal separator
                        var cleaned = parseFloat(val.replace(/,/g, ''));
                        if (!isNaN(cleaned)) {
                            $(this).val(cleaned.toString());
                        }
                    }
                });
            });
        });
        var lineCounter = @Model.Lines.Count;

        function addLine() {
            var index = lineCounter;
            var newRow = `
                <tr class="line-item" data-index="${index}">
                    <td>
                        <select name="Lines[${index}].ArticleId" class="form-select product-select" data-index="${index}" onchange="loadProductDetails(this, ${index})">
                            <option value="">-- Select Product --</option>
                            @foreach (var article in Model.Articles)
                            {
                                    <option value="@article.Value">@article.Text</option>
                            }
                        </select>
                        <div class="product-details-${index} small text-muted mt-1"></div>
                    </td>
                    <td>
                        <select name="Lines[${index}].WarehouseId" class="form-select">
                            <option value="">-- Default --</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                    <option value="@wh.Value">@wh.Text</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="number" name="Lines[${index}].Quantity" class="form-control quantity" step="0.01" onchange="updateLineTotal(${index})" />
                    </td>
                    <td>
                        <input type="number" name="Lines[${index}].UnitCost" class="form-control unit-cost" step="0.01" onchange="updateLineTotal(${index})" />
                    </td>
                    <td class="line-total-${index} text-end fw-bold">$0.00</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeLine(this)">
                            <i class="align-middle" data-feather="x"></i>
                        </button>
                    </td>
                </tr>
                <tr id="tracking-row-${index}" class="tracking-row" style="display:none;">
                    <td colspan="6" class="bg-light">
                        <div class="row p-2">
                            <div class="col-md-4">
                                <label class="form-label small">Batch/Lot Number</label>
                                <input type="text" name="Lines[${index}].BatchNumber" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Serial Number</label>
                                <input type="text" name="Lines[${index}].SerialNumber" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Expiry Date</label>
                                <input type="date" name="Lines[${index}].ExpiryDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </td>
                </tr>
            `;
            $('#itemsBody').append(newRow);
            lineCounter++;
            updateSummary();
        }

        function removeLine(btn) {
            $(btn).closest('tr.line-item').remove();
            $(btn).closest('tr.line-item').next('tr.tracking-row').remove();
            updateSummary();
        }

        function loadProductDetails(select, index) {
            var articleId = $(select).val();
            if (!articleId) return;

            $.ajax({
                url: '@Url.Action("GetProductDetails", "BeginningBalance")',
                type: 'GET',
                data: { articleId: articleId },
                success: function(response) {
                    if (response.success) {
                        $(`.product-details-${index}`).html(`<small>${response.articleCode} | Cost: $${response.standardCost.toFixed(2)}</small>`);
                        $(`input[name="Lines[${index}].UnitCost"]`).val(response.standardCost);

                        var showTracking = response.isBatchTracked || response.isSerialized || response.isExpiryTracked;
                        if (showTracking) {
                            $(`#tracking-row-${index}`).show();
                        } else {
                            $(`#tracking-row-${index}`).hide();
                        }
                        updateLineTotal(index);
                    }
                }
            });
        }

        function updateLineTotal(index) {
            var quantity = parseFloat($(`input[name="Lines[${index}].Quantity"]`).val()) || 0;
            var unitCost = parseFloat($(`input[name="Lines[${index}].UnitCost"]`).val()) || 0;
            var total = quantity * unitCost;
            $(`.line-total-${index}`).text('$' + total.toFixed(2));
            updateSummary();
        }

        function updateSummary() {
            var totalItems = 0;
            var totalQuantity = 0;
            var totalValue = 0;

            $('.line-item').each(function(index) {
                var quantity = parseFloat($(this).find('.quantity').val()) || 0;
                var unitCost = parseFloat($(this).find('.unit-cost').val()) || 0;
                if (quantity > 0 && unitCost > 0) {
                    totalItems++;
                    totalQuantity += quantity;
                    totalValue += quantity * unitCost;
                }
            });

            $('#totalItemsDisplay').text(totalItems);
            $('#totalQuantityDisplay').text(totalQuantity.toFixed(2));
            $('#totalValueDisplay').text('$' + totalValue.toFixed(2));
        }

        $(document).ready(function() {
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                    <text>updateLineTotal(@i);</text>
            }
            updateSummary();
        });
    </script>
}