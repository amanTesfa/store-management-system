@model Voucher

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Invoice Details</h1>
    <span class="badge bg-dark text-white ms-2">@Model.VoucherNumber</span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Invoice Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%">Invoice Number</th>
                        <td><code>@Model.VoucherNumber</code></td>
                    </tr>
                    <tr>
                        <th>Sales Order</th>
                        <td><code>@ViewBag.SONumber</code></td>
                    </tr>
                    <tr>
                        <th>Customer</th>
                        <td>@(Model.Consignee?.ConsigneeName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Invoice Date</th>
                        <td>@Model.VoucherDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th>Due Date</th>
                        <td>@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @{
                                var statusClass = Model.Status == "Draft" ? "warning" :
                                Model.Status == "Posted" ? "info" :
                                Model.Status == "Paid" ? "success" : "danger";
                            }
                            <span class="badge bg-@statusClass">@Model.Status</span>
                        </td>
                    </tr>
                    <tr>
                        <th>Remarks</th>
                        <td>@(Model.Remarks ?? "N/A")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Financial Summary</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 50%">Subtotal</th>
                        <td class="text-end">@Model.SubTotal.ToString("C")</td>
                    </tr>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr>
                            <th>Discount</th>
                            <td class="text-end text-danger">-@Model.DiscountAmount.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.TaxAmount > 0)
                    {
                        <tr>
                            <th>Tax</th>
                            <td class="text-end">@Model.TaxAmount.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <th>Total Amount</th>
                        <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </table>
            </div>
        </div>

        @if (Model.Status == "Paid")
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Payment Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th>Paid At</th>
                            <td>@(Model.PaidAt?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Payment Reference</th>
                            <td>@(Model.PaymentReference ?? "N/A")</td>
                        </tr>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Invoiced Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.VoucherLines)
                    {
                        <tr>
                            <td>
                                <strong>@line.Article?.ArticleCode</strong><br />
                                <small class="text-muted">@line.Article?.ArticleName</small>
                            </td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@line.UnitPrice.ToString("C")</td>
                            <td class="text-end">@line.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">Total:</td>
                        <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="align-middle" data-feather="arrow-left"></i> Back to List
    </a>
    <div>
        @if (Model.Status == "Posted")
        {
            <button type="button" class="btn btn-success" onclick="markAsPaid(@Model.Id)">
                <i class="align-middle" data-feather="dollar-sign"></i> Mark as Paid
            </button>
        }
    </div>
</div>

@section Scripts {
    <script>
        function markAsPaid(id) {
            if (confirm('Mark this invoice as paid?')) {
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("MarkAsPaid", "Invoices")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            showToast('error', response.message);
                        }
                    }
                });
            }
        }

        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `<div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;"><div class="d-flex"><div class="toast-body"><i class="align-middle me-2" data-feather="${icon}"></i>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(() => { $('.toast').last().remove(); }, 3000);
        }
    </script>
}