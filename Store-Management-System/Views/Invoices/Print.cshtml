@model Voucher

@{
    Layout = null;
    var customer = Model.Consignee;
    var lines = Model.VoucherLines.ToList();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.VoucherNumber</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            font-size: 14px;
        }

        .invoice-container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #4361ee;
        }

        .company-name {
            font-size: 28px;
            font-weight: bold;
            color: #4361ee;
        }

        .invoice-title {
            font-size: 24px;
            margin-top: 10px;
        }

        .info-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .info-box {
            width: 45%;
        }

            .info-box h4 {
                margin-bottom: 10px;
                color: #4361ee;
            }

            .info-box p {
                margin: 5px 0;
                line-height: 1.4;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .text-right {
            text-align: right;
        }

        .total-section {
            text-align: right;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid #ddd;
        }

        .total-row {
            font-size: 18px;
            font-weight: bold;
        }

        .footer {
            text-align: center;
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            font-size: 12px;
            color: #666;
        }
        @@media print {
            body

        {
            margin: 0;
            padding: 20px;
        }

        .no-print {
            display: none;
        }

        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="header">
            <div class="company-name">Inventory Management System</div>
            <div class="invoice-title">TAX INVOICE</div>
        </div>

        <div class="info-section">
            <div class="info-box">
                <h4>Bill To:</h4>
                <p><strong>@customer?.ConsigneeName</strong></p>
                <p>@customer?.BillingAddress</p>
                <p>@customer?.City, @customer?.State @customer?.PostalCode</p>
                <p>Tax ID: @customer?.TaxNumber</p>
            </div>
            <div class="info-box">
                <h4>Invoice Details:</h4>
                <p><strong>Invoice #:</strong> @Model.VoucherNumber</p>
                <p><strong>Date:</strong> @Model.VoucherDate.ToString("yyyy-MM-dd")</p>
                <p><strong>Due Date:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                <p><strong>PO Reference:</strong> @ViewBag.SONumber</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Description</th>
                    <th class="text-right">Quantity</th>
                    <th class="text-right">Unit Price</th>
                    <th class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var line in lines)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@line.Article?.ArticleName</td>
                        <td class="text-right">@line.Quantity.ToString("N2")</td>
                        <td class="text-right">@line.UnitPrice.ToString("C")</td>
                        <td class="text-right">@line.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-section">
            <p>Subtotal: <strong>@Model.SubTotal.ToString("C")</strong></p>
            @if (Model.TaxAmount > 0)
            {
                <p>Tax: @Model.TaxAmount.ToString("C")</p>
            }
            @if (Model.DiscountAmount > 0)
            {
                <p>Discount: -@Model.DiscountAmount.ToString("C")</p>
            }
            <p class="total-row">Total: @Model.TotalAmount.ToString("C")</p>
        </div>

        <div class="footer">
            <p>Thank you for your business!</p>
            <p>Payment is due within 30 days.</p>
            <p>For questions, please contact support@inventory.com</p>
        </div>
    </div>

    <div class="no-print" style="text-align: center; margin-top: 20px;">
        <button onclick="window.print()" class="btn btn-primary">Print Invoice</button>
        <button onclick="window.close()" class="btn btn-secondary">Close</button>
    </div>
</body>
</html>