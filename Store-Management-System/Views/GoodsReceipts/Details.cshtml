@model Voucher

@{
    ViewData["Title"] = "Goods Receipt Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Goods Receipt Details</h1>
    <span class="badge bg-dark text-white ms-2">@Model.VoucherNumber</span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Receipt Information</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%">GRN Number</th>
                        <td><code>@Model.VoucherNumber</code></td>
                    </tr>
                    <tr>
                        <th>Purchase Order</th>
                        <td><code>@ViewBag.PONumber</code></td>
                    </tr>
                    <tr>
                        <th>Supplier</th>
                        <td>@(Model.Supplier?.Name ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Receipt Date</th>
                        <td>@Model.VoucherDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td><span class="badge bg-success">@Model.Status</span></td>
                    </tr>
                    <tr>
                        <th>Remarks</th>
                        <td>@(Model.Remarks ?? "N/A")</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 50%">Total Items</th>
                        <td class="text-end"><span class="badge bg-info">@Model.VoucherLines.Count</span></td>
                    </tr>
                    <tr>
                        <th>Total Value</th>
                        <td class="text-end fw-bold text-success">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Received Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-scrollable">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Final Cost</th>
                        <th class="text-end">Total</th>
                        <th>Accepted</th>
                        <th>Batch/Serial</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.VoucherLines)
                    {
                        var isAccepted = line.IsAccepted;
                        <tr>
                            <td>
                                <strong>@line.Article?.ArticleCode</strong><br />
                                <small class="text-muted">@line.Article?.ArticleName</small>
                            </td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@line.UnitPrice.ToString("C")</td>
                            <td class="text-end">@(line.FinalUnitCost?.ToString("C") ?? line.UnitPrice.ToString("C"))</td>
                            <td class="text-end fw-bold">@((line.Quantity * (line.FinalUnitCost ?? line.UnitPrice)).ToString("C"))</td>
                            <td>
                                @if (isAccepted)
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                    if (!string.IsNullOrEmpty(line.RejectionReason))
                                    {
                                        <br />
                            
                                        <small class="text-muted">@line.RejectionReason</small>
                                    }
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(line.BatchNumber))
                                {
                                    <span class="badge bg-info">Batch: @line.BatchNumber</span>
                                }
                                @if (!string.IsNullOrEmpty(line.SerialNumber))
                                {
                                    <span class="badge bg-secondary">SN: @line.SerialNumber</span>
                                }
                                @if (string.IsNullOrEmpty(line.BatchNumber) && string.IsNullOrEmpty(line.SerialNumber))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td colspan="4" class="text-end">Total Value:</td>
                        <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="align-middle" data-feather="arrow-left"></i> Back to List
    </a>
    <a asp-controller="Returns" asp-action="Create" asp-route-receiptId="@Model.Id" class="btn btn-warning">
        <i class="align-middle" data-feather="rotate-ccw"></i> Return to Supplier
    </a>
</div>