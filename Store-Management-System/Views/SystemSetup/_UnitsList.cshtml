@model UnitIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group w-50">
        <input type="text" id="unitSearch" class="form-control" placeholder="Search units..." value="@Model.SearchTerm" />
        <button class="btn btn-outline-primary" id="searchUnitBtn">
            <i class="align-middle" data-feather="search"></i>
        </button>
    </div>
    <button type="button" class="btn btn-primary" onclick="openUnitModal(0)">
        <i class="align-middle" data-feather="plus"></i> Add Unit
    </button>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Type</th>
                <th>Base Unit</th>
                <th>Conversion</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Units)
            {
                <tr>
                    <td><code>@u.UnitCode</code></td>
                    <td><strong>@u.UnitName</strong></td>
                    <td><span>u.UnitType</span></td>
                    <td><span>@(u.BaseUnitName ?? "-")</span></td>
                    <td><span>@u.ConversionFactor</span></td>
                    <td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick="openUnitModal(@u.Id)" title="Edit">
                            <i class="align-middle" data-feather="edit-2"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteUnit(@u.Id, '@u.UnitName')" title="Delete">
                            <i class="align-middle" data-feather="trash-2"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3 d-flex justify-content-between">
    <small>Page @Model.CurrentPage of @Model.TotalPages</small>
    <div>
        <button class="btn btn-sm btn-outline-secondary" onclick="changeUnitPage(@Model.CurrentPage - 1)" @(Model.CurrentPage <= 1 ? "disabled" : "")>Previous</button>
        <button class="btn btn-sm btn-outline-secondary" onclick="changeUnitPage(@Model.CurrentPage + 1)" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>Next</button>
    </div>
</div>

<script>
    var unitPage = @Model.CurrentPage;
    var unitSearch = '@Model.SearchTerm';

    function refreshUnits() {
        var url = '@Url.Action("UnitsList", "SystemSetup")?searchTerm=' + encodeURIComponent(unitSearch) + '&page=' + unitPage;
        $.ajax({ url: url, success: function(r) { $('#unitsContent').html(r); feather.replace(); } });
    }

    function changeUnitPage(page) { unitPage = page; refreshUnits(); }
    $('#unitSearch').on('keypress', function(e) { if (e.which === 13) { unitSearch = $(this).val(); unitPage = 1; refreshUnits(); } });
    $('#searchUnitBtn').on('click', function() { unitSearch = $('#unitSearch').val(); unitPage = 1; refreshUnits(); });
</script>