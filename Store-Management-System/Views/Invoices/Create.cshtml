@model InvoiceViewModel

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Create Invoice</h1>
    <span class="badge bg-dark text-white ms-2">Billing</span>
</div>

<form id="mainForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceNumber" />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Invoice Information</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
                        <input asp-for="InvoiceNumber" class="form-control" readonly style="background-color: #e9ecef;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="SalesOrderId" class="form-label">Sales Order *</label>
                        <select asp-for="SalesOrderId" class="form-select" id="SalesOrderId" asp-items="Model.SalesOrders">
                            <option value="">-- Select Sales Order --</option>
                        </select>
                        <span asp-validation-for="SalesOrderId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="InvoiceDate" class="form-label">Invoice Date *</label>
                                <input asp-for="InvoiceDate" class="form-control" type="date" />
                                <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DueDate" class="form-label">Due Date</label>
                                <input asp-for="DueDate" class="form-control" type="date" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Summary</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" id="soInfo">
                        Select a Sales Order to see details.
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Subtotal:</strong>
                        <span id="subtotalDisplay">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Total:</strong>
                        <strong id="totalDisplay">$0.00</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5 class="card-title mb-0">Items to Invoice</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Shipped Qty</th>
                            <th>Previously Invoiced</th>
                            <th>Available</th>
                            <th>To Invoice</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Select a Sales Order to load items.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="align-middle" data-feather="save"></i> Create Invoice
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            console.log('jQuery loaded successfully');
            feather.replace();

            $('#SalesOrderId').on('change', function() {
                var soId = $(this).val();
                console.log('SO Selected:', soId);

                if (soId) {
                    $.ajax({
                        url: '@Url.Action("GetSalesOrderLines", "Invoices")',
                        type: 'GET',
                        data: { soId: soId },
                        success: function(response) {
                            console.log('Response:', response);
                            if (response.success) {
                                loadSOLines(response);
                            } else {
                                $('#itemsBody').html('<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load items.</td></tr>');
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('AJAX Error:', error);
                            $('#itemsBody').html('<tr><td colspan="7" class="text-center py-4 text-danger">Error loading items: ' + error + '</td></tr>');
                        }
                    });
                } else {
                    $('#itemsBody').html('<tr><td colspan="7" class="text-center py-4 text-muted">Select a Sales Order to load items.</td></tr>');
                    $('#soInfo').html('Select a Sales Order to see details.');
                }
            });
        });

        function loadSOLines(data) {
            console.log('Loading lines, count:', data.lines ? data.lines.length : 0);

            var html = '';
            var index = 0;

            $('#soInfo').html('<strong>Sales Order #' + data.soNumber + '</strong><br />Customer: ' + data.customerName);

            if (data.lines && data.lines.length > 0) {
                for (var i = 0; i < data.lines.length; i++) {
                    var line = data.lines[i];
                    console.log('Line:', line);

                    // Use ordered quantity instead of shipped quantity for invoicing
                    var availableToInvoice = line.orderedQuantity - line.previouslyInvoiced;

                    if (availableToInvoice <= 0) continue;

                    html += `
                        <tr class="invoice-line" data-index="${index}">
                            <input type="hidden" name="Lines[${index}].SalesOrderLineId" value="${line.lineId}" />
                            <input type="hidden" name="Lines[${index}].ArticleId" value="${line.articleId}" />
                            <input type="hidden" name="Lines[${index}].UnitPrice" value="${line.unitPrice}" />
                            <td>
                                <strong>${line.articleCode}</strong><br />
                                <small class="text-muted">${escapeHtml(line.articleName)}</small>
                            </td>
                            <td class="text-end">${line.orderedQuantity}</td>
                            <td class="text-end">${line.previouslyInvoiced}</td>
                            <td class="text-end text-primary">${availableToInvoice}</td>
                            <td>
                                <input type="number" name="Lines[${index}].Quantity" class="form-control invoice-qty"
                                       style="width: 100px;" value="${availableToInvoice}"
                                       min="0" max="${availableToInvoice}" onchange="calculateTotal()" />
                            </td>
                            <td class="text-end">${line.unitPrice.toFixed(2)}</td>
                            <td class="line-total-${index} text-end fw-bold">${(availableToInvoice * line.unitPrice).toFixed(2)}</td>
                        </tr>
                    `;
                    index++;
                }
            }

            if (index === 0) {
                html = '<tr><td colspan="7" class="text-center py-4 text-muted">No items available to invoice from this Sales Order.</td></tr>';
            }

            $('#itemsBody').html(html);
            calculateTotal();
        }

        function calculateTotal() {
            var subtotal = 0;
            $('.invoice-line').each(function(idx) {
                var qty = parseFloat($(this).find('.invoice-qty').val()) || 0;
                var price = parseFloat($(this).find('input[name$=".UnitPrice"]').val()) || 0;
                var total = qty * price;
                var lineIndex = $(this).data('index');
                if (lineIndex !== undefined) {
                    $('.line-total-' + lineIndex).text('$' + total.toFixed(2));
                }
                subtotal += total;
            });
            $('#subtotalDisplay').text('$' + subtotal.toFixed(2));
            $('#totalDisplay').text('$' + subtotal.toFixed(2));
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }
    </script>
}