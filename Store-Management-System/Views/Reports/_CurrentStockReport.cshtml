@model List<CurrentStockReportViewModel>
@Html.AntiForgeryToken()
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="row g-2 w-100">
        <div class="col-md-3">
            <select id="warehouseFilter" class="form-select" asp-items="ViewBag.Warehouses"></select>
        </div>
        <div class="col-md-3">
            <select id="categoryFilter" class="form-select" asp-items="ViewBag.Categories"></select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" id="applyFilterBtn">Apply Filter</button>
        </div>
        <div class="col-md-2">
            <button class="btn btn-success w-100" id="exportExcelBtn">
                <i class="align-middle" data-feather="download"></i> Export CSV
            </button>
        </div>
    </div>
</div>

<div class="table-responsive table-scrollable">
    <table class="table table-bordered table-hover datatable">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Warehouse</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Unit Cost</th>
                <th class="text-end">Total Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ArticleCode</td>
                    <td>@item.ArticleName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.WarehouseName</td>
                    <td class="text-end">@item.Quantity.ToString("N2")</td>
                    <td class="text-end">@item.UnitCost.ToString("C")</td>
                    <td class="text-end fw-bold">@item.TotalValue.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr class="fw-bold">
                <td colspan="6" class="text-end">Total Value:</td>
                <td class="text-end">@Model.Sum(m => m.TotalValue).ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
    $('#applyFilterBtn').on('click', function () {
        var warehouseId = $('#warehouseFilter').val();
        var categoryId = $('#categoryFilter').val();

        $.ajax({
            url: '@Url.Action("CurrentStock", "Reports")',
            type: 'GET',
            data: { warehouseId: warehouseId, categoryId: categoryId },
            success: function (response) {
                $('#currentStockContent').html(response);
                feather.replace();
            }
        });
    });

    $('#exportExcelBtn').on('click', function () {
        var warehouseId = $('#warehouseFilter').val();
        var categoryId = $('#categoryFilter').val();

        var form = $('<form action="@Url.Action("ExportCurrentStockToExcel", "Reports")" method="post"></form>');
        form.append('<input type="hidden" name="warehouseId" value="' + warehouseId + '" />');
        form.append('<input type="hidden" name="categoryId" value="' + categoryId + '" />');
        form.append('@Html.AntiForgeryToken()');

        $('body').append(form);
        form.submit();
        form.remove();
    });
</script>