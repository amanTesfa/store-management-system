@model StockAdjustmentViewModel

@{
    ViewData["Title"] = "Stock Adjustment Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Stock Adjustment Details</h1>
    <span class="badge bg-dark text-white ms-2">@Model.AdjustmentNumber</span>
</div>

<div class="row">
    <!-- LEFT -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Adjustment Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Adjustment #</th>
                        <td><code>@Model.AdjustmentNumber</code></td>
                    </tr>
                    <tr>
                        <th>Warehouse</th>
                        <td>
                            @(Model.WarehouseName
                                                        ?? Model.Warehouses?.FirstOrDefault(w => w.Value == Model.WarehouseId.ToString())?.Text
                                                        ?? "N/A")
                        </td>
                    </tr>
                    <tr>
                        <th>Adjustment Date</th>
                        <td>@Model.AdjustmentDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th>Adjustment Type</th>
                        <td>
                            <span class="@(Model.AdjustmentType == "WriteOff" ? "text-danger" :
                                                                            Model.AdjustmentType == "WriteOn" ? "text-success" : "text-warning")">
                                @Model.AdjustmentType
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Reason Category</th>
                        <td>@Model.ReasonCategory</td>
                    </tr>
                    <tr>
                        <th>Reason Description</th>
                        <td>@(Model.ReasonDescription ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Reference Number</th>
                        <td>@(Model.ReferenceNumber ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @{
                                var statusClass = Model.Status == "Draft" ? "warning" :
                                Model.Status == "Submitted" ? "info" :
                                Model.Status == "Approved" ? "primary" :
                                Model.Status == "Posted" ? "success" : "secondary";
                            }
                            <span class="badge bg-@statusClass">@Model.Status</span>
                        </td>
                    </tr>
                    <tr>
                        <th>Notes</th>
                        <td>@(Model.Notes ?? "N/A")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Total Items</th>
                        <td class="text-end">@Model.Lines.Count</td>
                    </tr>
                    <tr>
                        <th>Total Value</th>
                        <td class="text-end @(Model.TotalValue > 0 ? "text-success" : "text-danger")">
                            @Model.TotalValue.ToString("C")
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ITEMS -->
<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Adjusted Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">System Qty</th>
                        <th class="text-end">Physical Qty</th>
                        <th class="text-end">Variance</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Total</th>
                        <th>Batch/Serial</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong>@line.ArticleCode</strong><br />
                                <small class="text-muted">@line.ArticleName</small>
                            </td>
                            <td class="text-end">@line.SystemQuantity.ToString("N2")</td>
                            <td class="text-end">@line.PhysicalQuantity.ToString("N2")</td>
                            <td class="text-end @(line.Variance > 0 ? "text-success" : "text-danger")">
                                @line.Variance.ToString("N2")
                            </td>
                            <td class="text-end">@line.UnitCost.ToString("C")</td>
                            <td class="text-end @(line.TotalValue > 0 ? "text-success" : "text-danger")">
                                @line.TotalValue.ToString("C")
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(line.BatchNumber))
                                {
                                    <span class="badge bg-info">Batch: @line.BatchNumber</span>
                                }
                                @if (!string.IsNullOrEmpty(line.SerialNumber))
                                {
                                    <span class="badge bg-secondary">SN: @line.SerialNumber</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="5" class="text-end">Total:</td>
                        <td class="text-end @(Model.TotalValue > 0 ? "text-success" : "text-danger")">
                            @Model.TotalValue.ToString("C")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submitAdjustment(id) {
            showConfirm('Submit this adjustment for approval?', function() {
                $('#loadingSpinner').fadeIn(200);
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Submit", "StockAdjustments")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) { showToast('success', response.message); setTimeout(function() { location.reload(); }, 1500); }
                        else { showToast('error', response.message); }
                    },
                    error: function() { $('#loadingSpinner').fadeOut(200); showToast('error', 'An error occurred.'); }
                });
            });
        }

        function approveAdjustment(id) {
            var comments = prompt('Enter approval comments (optional):');
            $('#loadingSpinner').fadeIn(200);
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("Approve", "StockAdjustments")',
                type: 'POST',
                data: { id: id, comments: comments, __RequestVerificationToken: token },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    if (response.success) { showToast('success', response.message); setTimeout(function() { location.reload(); }, 1500); }
                    else { showToast('error', response.message); }
                },
                error: function() { $('#loadingSpinner').fadeOut(200); showToast('error', 'An error occurred.'); }
            });
        }

        function rejectAdjustment(id) {
            var reason = prompt('Enter rejection reason:');
            if (reason) {
                $('#loadingSpinner').fadeIn(200);
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Reject", "StockAdjustments")',
                    type: 'POST',
                    data: { id: id, reason: reason, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) { showToast('success', response.message); setTimeout(function() { location.reload(); }, 1500); }
                        else { showToast('error', response.message); }
                    },
                    error: function() { $('#loadingSpinner').fadeOut(200); showToast('error', 'An error occurred.'); }
                });
            }
        }

        function postAdjustment(id) {
            showConfirm('Post this adjustment to inventory? This will update stock levels and cannot be undone.', function() {
                $('#loadingSpinner').fadeIn(200);
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Post", "StockAdjustments")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) { showToast('success', response.message); setTimeout(function() { location.reload(); }, 1500); }
                        else { showToast('error', response.message); }
                    },
                    error: function() { $('#loadingSpinner').fadeOut(200); showToast('error', 'An error occurred.'); }
                });
            });
        }

        function cancelAdjustment(id) {
            var reason = prompt('Enter cancellation reason:');
            if (reason) {
                $('#loadingSpinner').fadeIn(200);
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Cancel", "StockAdjustments")',
                    type: 'POST',
                    data: { id: id, reason: reason, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) { showToast('success', response.message); setTimeout(function() { location.reload(); }, 1500); }
                        else { showToast('error', response.message); }
                    },
                    error: function() { $('#loadingSpinner').fadeOut(200); showToast('error', 'An error occurred.'); }
                });
            }
        }

        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `<div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;"><div class="d-flex"><div class="toast-body"><i class="align-middle me-2" data-feather="${icon}"></i>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(() => { $('.toast').last().remove(); }, 3000);
        }
    </script>
}