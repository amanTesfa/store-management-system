@model List<StockValuationCategoryViewModel>

@{
    var totalValue = ViewBag.TotalValue ?? 0m;
    var totalQuantity = ViewBag.TotalQuantity ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="row g-2 w-100">
        <div class="col-md-3">
            <select id="warehouseFilter" class="form-select" asp-items="ViewBag.Warehouses"></select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" id="applyFilterBtn">Apply Filter</button>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="alert alert-info">
            <strong>Total Inventory Value:</strong>
            <h2 class="mt-2">@totalValue.ToString("C")</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-secondary">
            <strong>Total Stock Quantity:</strong>
            <h2 class="mt-2">@totalQuantity.ToString("N0") units</h2>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Valuation by Category</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Value</th>
                                <th class="text-end">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var percentage = totalValue > 0 ? (item.TotalValue / totalValue * 100) : 0;
                                <tr>
                                    <td><strong>@item.CategoryName</strong></td>
                                    <td class="text-end">@item.TotalQuantity.ToString("N0")</td>
                                    <td class="text-end">@item.TotalValue.ToString("C")</td>
                                    <td class="text-end">@percentage.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td class="text-end">Total:</td>
                                <td class="text-end">@totalQuantity.ToString("N0")</td>
                                <td class="text-end">@totalValue.ToString("C")</td>
                                <td class="text-end">100%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Valuation Chart</h5>
            </div>
            <div class="card-body">
                <canvas id="valuationChart" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    function renderValuationChart() {
        var ctx = document.getElementById('valuationChart').getContext('2d');

        var categories = @Html.Raw(Json.Serialize(Model.Select(m => m.CategoryName)));
        var values = @Html.Raw(Json.Serialize(Model.Select(m => m.TotalValue)));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: categories,
                datasets: [{
                    label: 'Stock Value',
                    data: values,
                    backgroundColor: '#4361ee',
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '$' + context.raw.toFixed(2);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    }

    $('#applyFilterBtn').on('click', function () {
        var warehouseId = $('#warehouseFilter').val();

        $.ajax({
            url: '@Url.Action("StockValuation", "Reports")',
            type: 'GET',
            data: { warehouseId: warehouseId },
            success: function (response) {
                $('#stockValuationContent').html(response);
                feather.replace();
                renderValuationChart();
            }
        });
    });

    $(document).ready(function () {
        renderValuationChart();
    });
</script>