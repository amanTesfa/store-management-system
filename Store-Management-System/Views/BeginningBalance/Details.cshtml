@model BeginningBalanceDetailsViewModel

@{
    ViewData["Title"] = "Beginning Balance Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Beginning Balance Details</h1>
    <span class="badge bg-dark text-white ms-2">@Model.BalanceNumber</span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Balance Information</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">

                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%">Balance Number</th>
                        <td><code>@Model.BalanceNumber</code></td>
                    </tr>
                    <tr>
                        <th>Fiscal Period</th>
                        <td>@(Model.FiscalPeriodName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Default Warehouse</th>
                        <td>@(Model.WarehouseName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>@(Model.Description ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge bg-@Model.StatusClass">
                                @Model.Status
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Created At</th>
                        <td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>Created By</th>
                        <td>@(Model.CreatedByName ?? "System")</td>
                    </tr>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <tr>
                            <th>Approved At</th>
                            <td>@Model.ApprovedAt.Value.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Approved By</th>
                            <td>@(Model.ApprovedByName ?? "N/A")</td>
                        </tr>
                    }
                    @if (Model.PostedAt.HasValue)
                    {
                        <tr>
                            <th>Posted At</th>
                            <td>@Model.PostedAt.Value.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Posted By</th>
                            <td>@(Model.PostedByName ?? "N/A")</td>
                        </tr>
                    }
                </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">

                <table class="table table-bordered">
                    <tr>
                        <th style="width: 50%">Total Items</th>
                        <td class="text-end"><span class="badge bg-info">@Model.TotalItems</span></td>
                    </tr>
                    <tr>
                        <th>Total Quantity</th>
                        <td class="text-end">@Model.TotalQuantity.ToString("N2")</td>
                    </tr>
                    <tr>
                        <th>Total Value</th>
                        <td class="text-end fw-bold text-success">@Model.TotalValue.ToString("C")</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Line Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-scrollable">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Warehouse</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Total Value</th>
                        <th>Batch/Serial</th>
                        <th>Expiry Date</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong>@line.ArticleCode</strong><br />
                                <small class="text-muted">@line.ArticleName</small>
                            </td>
                            <td>@(line.WarehouseName ?? "Default")</td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@line.UnitCost.ToString("C")</td>
                            <td class="text-end fw-bold">@line.TotalValue.ToString("C")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(line.BatchNumber))
                                {
                                    <span class="badge bg-info">Batch: @line.BatchNumber</span>
                                }
                                @if (!string.IsNullOrEmpty(line.SerialNumber))
                                {
                                    <span class="badge bg-secondary">SN: @line.SerialNumber</span>
                                }
                                @if (string.IsNullOrEmpty(line.BatchNumber) && string.IsNullOrEmpty(line.SerialNumber))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @(line.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
                            </td>
                            <td>
                                @(line.Notes ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Totals:</td>
                        <td class="text-end fw-bold">@Model.TotalValue.ToString("C")</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-between">
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
    </div>
    <div>
        @if (Model.Status == "Draft")
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="align-middle" data-feather="edit-2"></i> Edit
            </a>
            <button type="button" class="btn btn-success" onclick="approveBalance(@Model.Id)">
                <i class="align-middle" data-feather="check-circle"></i> Approve
            </button>
            <button type="button" class="btn btn-danger" onclick="deleteBalance(@Model.Id, '@Model.BalanceNumber')">
                <i class="align-middle" data-feather="trash-2"></i> Delete
            </button>
        }
        @if (Model.Status == "Approved")
        {
            <button type="button" class="btn btn-primary" onclick="postBalance(@Model.Id)">
                <i class="align-middle" data-feather="upload"></i> Post to Inventory
            </button>
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function approveBalance(id) {
            if (confirm('Approve this beginning balance? Once approved, it can be posted to inventory.')) {
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Approve", "BeginningBalance")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            showToast('error', response.message);
                        }
                    }
                });
            }
        }

        function postBalance(id) {
            if (confirm('Post this beginning balance to inventory? This will update stock levels and cannot be undone.')) {
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Post", "BeginningBalance")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            showToast('error', response.message);
                        }
                    }
                });
            }
        }

        function deleteBalance(id, number) {
            if (confirm('Delete beginning balance ' + number + '? This action cannot be undone.')) {
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Delete", "BeginningBalance")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            window.location.href = '@Url.Action("Index", "BeginningBalance")';
                        } else {
                            showToast('error', response.message);
                        }
                    }
                });
            }
        }

        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `
                <div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="align-middle me-2" data-feather="${icon}"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(function() { $('.toast').last().remove(); }, 3000);
        }
    </script>
}