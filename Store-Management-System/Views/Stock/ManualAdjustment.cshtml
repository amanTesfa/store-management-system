

<!--
  Manual Stock Adjustment - Logistix Core inspired UI
  Uses Tailwind utility classes. Ensure Tailwind is available in the project
-->

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Manrope:wght@600;800&display=swap" rel="stylesheet">

<div class="min-h-screen bg-slate-50 p-6 font-inter">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-12 gap-6">

      <!-- LEFT SIDEBAR (Stepper & Guidelines) -->
      <aside class="col-span-3">
        <div class="bg-white rounded-lg border border-slate-200 p-5 mb-4">
          <h3 class="text-sm font-manrope text-slate-700 mb-3">Workflow</h3>
          <nav class="space-y-4">
            <!-- Step 1 - Source Info (checked) -->
            <div class="flex items-start gap-3">
              <div class="flex-none w-8 h-8 rounded-full bg-blue-700 text-white flex items-center justify-center">✓</div>
              <div>
                <div class="text-sm font-semibold">Source Info</div>
                <div class="text-xs text-slate-500">Warehouse & source details</div>
              </div>
            </div>

            <!-- Step 2 - Line Items (active) -->
            <div class="flex items-start gap-3">
              <div class="flex-none w-8 h-8 rounded-full bg-white border-2 border-blue-700 text-blue-700 flex items-center justify-center font-semibold">2</div>
              <div>
                <div class="text-sm font-semibold text-blue-700">Line Items</div>
                <div class="text-xs text-slate-500">Specify adjustments per SKU</div>
              </div>
            </div>

            <!-- Step 3 - Verification (pending) -->
            <div class="flex items-start gap-3">
              <div class="flex-none w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">3</div>
              <div>
                <div class="text-sm font-semibold text-slate-600">Verification</div>
                <div class="text-xs text-slate-500">Review & Approve</div>
              </div>
            </div>
          </nav>
        </div>

        <div class="bg-blue-50 rounded-lg p-4 border border-blue-100">
          <h4 class="text-sm font-semibold text-blue-700 mb-2">Guidelines</h4>
          <p class="text-sm text-slate-600">Use this screen to record manual stock adjustments. Provide a reason and attach supporting documents where applicable.</p>
          <a href="#" class="mt-3 inline-block text-sm text-blue-700 font-semibold">Read Standard Operating Procedures →</a>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="col-span-9">
        <form asp-action="SubmitAdjustment" method="post" enctype="multipart/form-data">
          <header class="flex items-start justify-between gap-4 mb-6">
            <div>
              <h1 class="text-2xl font-manrope text-slate-800">Step 2: Line Item Specification</h1>
              <p class="text-sm text-slate-500 mt-1">Specify items to adjust and the reason for the change.</p>
            </div>

            <div class="flex items-center gap-3">
              <button type="button" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-md text-sm text-slate-700 hover:scale-[0.98] transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                + Add Product
              </button>
            </div>
          </header>

          <!-- Adjustment Table -->
          <section class="bg-white rounded-lg border border-slate-200 p-4 mb-6">
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="text-left text-slate-600 border-b border-slate-200">
                    <th class="py-3 pr-6">SKU / Product</th>
                    <th class="py-3 pr-6">Current Stock</th>
                    <th class="py-3 pr-6">Adjustment</th>
                    <th class="py-3 pr-6">New Total</th>
                    <th class="py-3 pr-6">Reason</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  @if (Model?.LineItems != null)
                  {
                      foreach (var item in Model.LineItems)
                      {
                          <tr class="align-top">
                            <td class="py-4">
                              <div class="font-semibold text-slate-800">@item.ProductName</div>
                              <div class="text-xs text-slate-500">SKU: @item.Sku</div>
                            </td>
                            <td class="py-4">@item.CurrentStock</td>
                            <td class="py-4">
                              <div class="inline-flex items-center border border-slate-200 rounded-md overflow-hidden">
                                <button type="button" class="px-3 bg-slate-100 text-slate-600">-</button>
                                <input type="number" name="adjustment_@item.Sku" value="@item.Adjustment" class="w-20 text-center px-2 py-1 text-sm" />
                                <button type="button" class="px-3 bg-slate-100 text-slate-600">+</button>
                              </div>
                            </td>
                            <td class="py-4">@((item.CurrentStock ?? 0) + (item.Adjustment ?? 0))</td>
                            <td class="py-4">
                              @if (!string.IsNullOrEmpty(item.Reason))
                              {
                                  if (item.Reason.Contains("Damage"))
                                  {
                                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-red-50 text-red-700">Damage</span>
                                  }
                                  else
                                  {
                                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-blue-50 text-blue-700">Found Inventory</span>
                                  }
                              }
                            </td>
                          </tr>
                      }
                  }
                  else
                  {
                      <!-- Fallback sample row -->
                      <tr>
                        <td class="py-4">
                          <div class="font-semibold text-slate-800">Industrial Drill X-200</div>
                          <div class="text-xs text-slate-500">SKU: DRL-X200</div>
                        </td>
                        <td class="py-4">120</td>
                        <td class="py-4">
                          <div class="inline-flex items-center border border-slate-200 rounded-md overflow-hidden">
                            <button type="button" class="px-3 bg-slate-100 text-slate-600">-</button>
                            <input type="number" name="adjustment_DRL-X200" value="0" class="w-20 text-center px-2 py-1 text-sm" />
                            <button type="button" class="px-3 bg-slate-100 text-slate-600">+</button>
                          </div>
                        </td>
                        <td class="py-4">120</td>
                        <td class="py-4"><span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-blue-50 text-blue-700">Found Inventory</span></td>
                      </tr>
                  }
                </tbody>
              </table>
            </div>
          </section>

          <!-- Form Inputs Area -->
          <section class="grid grid-cols-12 gap-6 mb-6">
            <div class="col-span-8">
              <div class="bg-white rounded-lg border border-slate-200 p-4">
                <label class="block text-sm font-semibold text-slate-700 mb-2">Adjustment Note</label>
                <textarea name="AdjustmentNote" rows="4" class="w-full rounded-md border border-slate-200 p-3 text-sm" placeholder="Add context for this adjustment (required)"></textarea>
              </div>
            </div>

            <div class="col-span-4">
              <div class="bg-white rounded-lg border border-slate-200 p-4">
                <label class="block text-sm font-semibold text-slate-700 mb-2">Documentation Upload</label>
                <label class="block border-2 border-dashed border-slate-200 rounded-md p-6 text-center text-sm text-slate-500 hover:bg-slate-50 transition-all cursor-pointer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-8 w-8 text-slate-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16v-4a4 4 0 014-4h1l1-2h2l1 2h1a4 4 0 014 4v4"/></svg>
                  <div class="text-sm">Drag & drop a file here or <span class="text-blue-700 underline">browse</span></div>
                  <input type="file" name="Documentation" class="hidden" />
                </label>
              </div>
            </div>
          </section>

          <!-- Summary & Actions -->
          <section class="flex items-start justify-between gap-6">
            <div class="flex gap-4">
              <div class="bg-white rounded-lg border border-slate-200 p-4 w-48">
                <div class="text-xs text-slate-500">Total Net Adjustment</div>
                <div class="text-lg font-semibold text-slate-800 mt-2">+8</div>
              </div>
              <div class="bg-white rounded-lg border border-slate-200 p-4 w-56">
                <div class="text-xs text-slate-500">Estimated Value Change</div>
                <div class="text-lg font-semibold text-slate-800 mt-2">+$1,920.00</div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <button type="button" class="px-4 py-2 rounded-md text-sm border border-slate-200 bg-white text-slate-700 hover:scale-[0.98] transition-all">Save as Draft</button>
              <a asp-action="PreviousStep" class="inline-block px-4 py-2 rounded-md text-sm border border-slate-300 text-slate-700 bg-white hover:scale-[0.98] transition-all">Previous Step</a>
              <button type="submit" class="px-4 py-2 rounded-md text-sm bg-[#005EB8] text-white hover:opacity-95 transition-all">Review & Submit</button>
            </div>
          </section>

        </form>
      </main>

    </div>
  </div>
</div>
