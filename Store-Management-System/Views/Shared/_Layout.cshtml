<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Inventory Management System">
    <meta name="author" content="YourCompany">
    <meta name="keywords" content="inventory, management, admin, dashboard">
    <!-- jsVectorMap for maps -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- Load app.js as a module -->
    <script type="module" src="~/js/app.js"></script>
    <script type="module" src="~/js/site.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jvectormap-next@3.1.0/jquery-jvectormap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/jvectormap-next@3.1.0/jquery-jvectormap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jvectormap-next@3.1.0/jquery-jvectormap-world-mill.js"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="shortcut icon" href="~/img/icons/icon-48x48.png" />

    <title>@ViewData["Title"] - Inventory Management System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- AdminKit CSS (requires download) -->
    <link href="~/css/app.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Feather Icons -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Flatpickr for calendar -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  
    <!-- SimpleBar for sidebar scrolling -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simplebar@5.3.6/dist/simplebar.min.css">
    <script src="https://cdn.jsdelivr.net/npm/simplebar@5.3.6/dist/simplebar.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <style>
        /* Fix scrolling - Sidebar fixed, content scrolls independently */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .wrapper {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar - Fixed position, scrolls internally if needed */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background: #2c3e50;
            color: #fff;
            height: 100vh;
            position: relative;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Sidebar content scrolling (if content overflows) */
        .sidebar-content {
            height: 100%;
            overflow-y: auto;
        }

        /* Main content area - This scrolls independently */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* Top navbar - Fixed at top */
        .navbar-bg {
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        /* Content area - This scrolls! */
        .content {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0;
        }

        /* Footer - Fixed at bottom */
        .footer {
            flex-shrink: 0;
            background: #fff;
            border-top: 1px solid #dee2e6;
            padding: 1rem 0;
        }

        /* Ensure cards and content look good when scrolling */
        .container-fluid {
            padding: 1.5rem;
        }

        /* Fix for simplebar on sidebar */
        .js-simplebar {
            height: 100%;
        }
    </style>
</head>

<body>
    <!-- PDF Viewer Modal -->
    <div class="modal fade" id="pdfModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="align-middle" data-feather="file-text"></i> Invoice Preview
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0" style="height: 80vh;">
                    <iframe id="pdfFrame" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <a id="downloadPdfLink" href="#" class="btn btn-primary" download>
                        <i class="align-middle" data-feather="download"></i> Download PDF
                    </a>
                    <button type="button" class="btn btn-success" onclick="window.print()">
                        <i class="align-middle" data-feather="printer"></i> Print
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Global Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="confirmModalTitle">Confirm Action</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmModalMessage">
                    Are you sure you want to perform this action?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmModalOk">Yes, Proceed</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Global Loading Spinner -->
    <div id="loadingSpinner" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; text-align: center; padding-top: 20%;">
        <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="mt-3 text-white">Processing...</div>
    </div>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar js-sidebar">
            <div class="sidebar-content js-simplebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <span class="align-middle">InventoryMS</span>
                </a>

                <ul class="sidebar-nav">
                    <!-- MAIN NAVIGATION -->
                    <li class="sidebar-header">
                        Main
                    </li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                            <i class="align-middle" data-feather="sliders"></i>
                            <span class="align-middle">Dashboard</span>
                        </a>
                    </li>

                    <!-- INVENTORY MANAGEMENT -->
                    <li class="sidebar-header">System Setup</li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="SystemSetup" asp-action="Index">
                            <i class="align-middle" data-feather="settings"></i>
                            <span class="align-middle">System Setup</span>
                        </a>
                    </li>
                

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Articles" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Articles" asp-action="Index">
                            <i class="align-middle" data-feather="box"></i>
                            <span class="align-middle">Articles</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "BeginningBalance" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="BeginningBalance" asp-action="Index">
                            <i class="align-middle" data-feather="database"></i>
                            <span class="align-middle">Beginning Balance</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Categories" asp-action="Index">
                            <i class="align-middle" data-feather="tag"></i>
                            <span class="align-middle">Categories</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Customers" asp-action="Index">
                            <i class="align-middle" data-feather="users"></i>
                            <span class="align-middle">Customers</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Suppliers" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Suppliers" asp-action="Index">
                            <i class="align-middle" data-feather="truck"></i>
                            <span class="align-middle">Suppliers</span>
                        </a>
                    </li>




                    <!-- Transactions Section -->
                    <li class="sidebar-header">Purchase Transactions</li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PurchaseOrders" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="PurchaseOrders" asp-action="Index">
                            <i class="align-middle" data-feather="shopping-cart"></i>
                            <span class="align-middle">Purchase Orders</span>
                        </a>
                    </li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "GoodsReceipts" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="GoodsReceipts" asp-action="Index">
                            <i class="align-middle" data-feather="package"></i>
                            <span class="align-middle">Goods Receipts</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Returns" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Returns" asp-action="Index">
                            <i class="align-middle" data-feather="package"></i>
                            <span class="align-middle">Returns</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockAdjustments" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="StockAdjustments" asp-action="Index">
                            <i class="align-middle" data-feather="refresh-cw"></i>
                            <span class="align-middle">Stock Adjustments</span>
                        </a>
                    </li>
                    <!-- Sales & Customers Section -->
                    <li class="sidebar-header">Sales Transaction</li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SalesOrders" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="SalesOrders" asp-action="Index">
                            <i class="align-middle" data-feather="shopping-bag"></i>
                            <span class="align-middle">Sales Orders</span>
                        </a>
                    </li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Invoices" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Invoices" asp-action="Index">
                            <i class="align-middle" data-feather="file-text"></i>
                            <span class="align-middle">Invoices</span>
                        </a>
                    </li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CustomerReturns" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="CustomerReturns" asp-action="Index">
                            <i class="align-middle" data-feather="rotate-ccw"></i>
                            <span class="align-middle">Customer Returns</span>
                        </a>
                    </li>
                  
                     
                    <!-- REPORTS -->
                    <li class="sidebar-header">Reports</li>

                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="Reports" asp-action="Index">
                            <i class="align-middle" data-feather="bar-chart-2"></i>
                            <span class="align-middle">Inventory Reports</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="sidebar-header">Activity Logs</li>

                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ActivityLogs" ? "active" : "")">
                            <a class="sidebar-link" asp-controller="ActivityLogs" asp-action="Index">
                                <i class="align-middle" data-feather="clock"></i>
                                <span class="align-middle">Activity Logs</span>
                            </a>
                        </li>
                    }
                    <!-- ADMINISTRATION (Visible only to Admin) -->
                    @* @if (User.IsInRole("Admin"))
                    {
                        <li class="sidebar-header">
                            Administration
                        </li>

                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                            <a class="sidebar-link" asp-controller="Users" asp-action="Index">
                                <i class="align-middle" data-feather="user-check"></i>
                                <span class="align-middle">User Management</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")">
                            <a class="sidebar-link" asp-controller="Roles" asp-action="Index">
                                <i class="align-middle" data-feather="shield"></i>
                                <span class="align-middle">Role Management</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="#">
                                <i class="align-middle" data-feather="database"></i>
                                <span class="align-middle">Backup & Restore</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="#">
                                <i class="align-middle" data-feather="settings"></i>
                                <span class="align-middle">System Settings</span>
                            </a>
                        </li>
                    } *@

                    <!-- USER SECTION -->
                    <li class="sidebar-header">
                        Account
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MLTraining" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="MLTraining" asp-action="Index">
                            <i class="align-middle" data-feather="cpu"></i>
                            <span class="align-middle">AI Training</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AIIntelligence" ? "active" : "")">
                        <a class="sidebar-link" asp-controller="AIIntelligence" asp-action="Index">
                            <i class="align-middle" data-feather="cpu"></i>
                            <span class="align-middle">AI Intelligence</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Profile" asp-action="Index">
                            <i class="align-middle" data-feather="user"></i>
                            <span class="align-middle">My Profile</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Profile" asp-action="ChangePassword">
                            <i class="align-middle" data-feather="key"></i>
                            <span class="align-middle">Change Password</span>
                        </a>
                    </li>
                </ul>

                <!-- Sidebar CTA (Optional - can remove if not needed) -->
                <div class="sidebar-cta">
                    <div class="sidebar-cta-content">
                        <strong class="d-inline-block mb-2">Need Help?</strong>
                        <div class="mb-3 text-sm">
                            Contact support for assistance with your inventory management.
                        </div>
                        <div class="d-grid">
                            <a href="#" class="btn btn-primary">Contact Support</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <div class="main">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand navbar-light navbar-bg">
                <a class="sidebar-toggle js-sidebar-toggle" id="sidebarCollapse">
                    <i class="hamburger align-self-center"></i>
                </a>

                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav navbar-align">
                        <!-- Notifications Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-icon dropdown-toggle" href="#" id="alertsDropdown" data-bs-toggle="dropdown">
                                <div class="position-relative">
                                    <i class="align-middle" data-feather="bell"></i>
                                    <span class="indicator">4</span>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end py-0" aria-labelledby="alertsDropdown">
                                <div class="dropdown-menu-header">
                                    4 New Notifications
                                </div>
                                <div class="list-group">
                                    <a href="#" class="list-group-item">
                                        <div class="row g-0 align-items-center">
                                            <div class="col-2">
                                                <i class="text-danger" data-feather="alert-circle"></i>
                                            </div>
                                            <div class="col-10">
                                                <div class="text-dark">Update completed</div>
                                                <div class="text-muted small mt-1">30m ago</div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="dropdown-menu-footer">
                                    <a href="#" class="text-muted">Show all notifications</a>
                                </div>
                            </div>
                        </li>

                        <!-- User Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-icon dropdown-toggle d-inline-block d-sm-none" href="#" data-bs-toggle="dropdown">
                                <i class="align-middle" data-feather="settings"></i>
                            </a>

                            <a class="nav-link dropdown-toggle d-none d-sm-inline-block" href="#" data-bs-toggle="dropdown">
                                <img src="~/img/avatars/avatar.jpg" class="avatar img-fluid rounded me-1" alt="User" />
                                <span class="text-dark">@User.Identity.Name</span>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                    <i class="align-middle me-1" data-feather="user"></i> Profile
                                </a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item" style="background: none; border: none; width: 100%; text-align: left;">
                                        <i class="align-middle me-1" data-feather="log-out"></i> Log out
                                    </button>
                                </form>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content - THIS SCROLLS INDEPENDENTLY -->
            <main class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row text-muted">
                        <div class="col-6 text-start">
                            <p class="mb-0">
                                <a class="text-muted" href="#"><strong>AdminKit</strong></a> &copy; @DateTime.Now.Year
                            </p>
                        </div>
                        <div class="col-6 text-end">
                            <ul class="list-inline">
                                <li class="list-inline-item">
                                    <a class="text-muted" href="#">Support</a>
                                </li>
                                <li class="list-inline-item">
                                    <a class="text-muted" href="#">Privacy</a>
                                </li>
                                <li class="list-inline-item">
                                    <a class="text-muted" href="#">Terms</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

 

    <script>
                // Suppress extension-related errors
        window.addEventListener('error', function(e) {
            if (e.message && e.message.includes('listener indicated an asynchronous response')) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        // Also suppress unhandled promise rejections from extensions
        window.addEventListener('unhandledrejection', function(e) {
            if (e.reason && e.reason.message && e.reason.message.includes('listener indicated an asynchronous response')) {
                e.preventDefault();
                return false;
            }
        });
        // Initialize Feather Icons (this can stay here)
        feather.replace();

        // Initialize sidebar toggle
        document.addEventListener("DOMContentLoaded", function() {
            var sidebarToggle = document.querySelector(".js-sidebar-toggle");
            if (sidebarToggle) {
                sidebarToggle.addEventListener("click", function() {
                    document.querySelector("#sidebar").classList.toggle("collapsed");
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>