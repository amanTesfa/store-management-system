@{
    ViewData["Title"] = "ERP Theme Demo";
    ViewData["UseErpTheme"] = true;
}

@* Demo page showing Tailwind-based ERP theme. This page uses the Tailwind Play CDN for quick preview.
   It is non-destructive: it does not modify the global layout. Include the partials manually to preview.
*@

<link href="~/css/erp-tailwind.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="min-h-screen bg-slate-50 font-inter pt-16 lg:pl-64">
  @* Include sidebar and topbar partials for demonstration (they won't be wired into _Layout automatically) *@
  @await Html.PartialAsync("_ErpSidebarTailwind")
  @await Html.PartialAsync("_ErpTopbarTailwind")

  <main class="max-w-7xl mx-auto p-6">
    <div class="grid grid-cols-12 gap-6">
      <section class="col-span-12">
        <div class="bg-white rounded-lg border border-slate-200 p-6">
          <h2 class="text-2xl font-manrope text-slate-800">Dashboard — ERP Theme (Tailwind)</h2>
          <p class="text-sm text-slate-500 mt-1">Preview of the non-destructive Tailwind theme for the inventory ERP module.</p>
        </div>
      </section>

      <section class="col-span-12 grid grid-cols-12 gap-6 mt-4">
        <div class="col-span-3 bg-white rounded-lg border border-slate-200 p-4">
          <div class="text-xs text-slate-500">Products</div>
          <div class="text-xl font-semibold mt-2">1,280</div>
        </div>
        <div class="col-span-3 bg-white rounded-lg border border-slate-200 p-4">
          <div class="text-xs text-slate-500">Low Stock</div>
          <div class="text-xl font-semibold mt-2">24</div>
        </div>
        <div class="col-span-3 bg-white rounded-lg border border-slate-200 p-4">
          <div class="text-xs text-slate-500">Suppliers</div>
          <div class="text-xl font-semibold mt-2">72</div>
        </div>
        <div class="col-span-3 bg-white rounded-lg border border-slate-200 p-4">
          <div class="text-xs text-slate-500">Orders</div>
          <div class="text-xl font-semibold mt-2">3,214</div>
        </div>
      </section>

      <section class="col-span-12 mt-4">
        <div class="bg-white rounded-lg border border-slate-200 p-4">
          <h3 class="text-lg font-semibold">Recent Products</h3>
          <div class="overflow-x-auto mt-4">
            <table class="w-full text-sm table-auto">
              <thead>
                <tr class="text-left text-slate-600">
                  <th class="p-3">SKU</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Stock</th>
                  <th class="p-3">Location</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                <tr class="hover:bg-slate-50">
                  <td class="p-3">PRD-001</td>
                  <td class="p-3">Industrial Drill X-200</td>
                  <td class="p-3">120</td>
                  <td class="p-3">WH-A</td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <td class="p-3">PRD-002</td>
                  <td class="p-3">Hydraulic Pump H-10</td>
                  <td class="p-3">40</td>
                  <td class="p-3">WH-B</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </div>
  </main>
</div>
