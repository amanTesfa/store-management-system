@model CustomerIndexViewModel

@{
    ViewData["Title"] = "Customers";
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 d-inline align-middle">Customers</h1>
        <span class="badge bg-dark text-white ms-2">CRM</span>
    </div>
    <button type="button" class="btn btn-primary" onclick="loadCreateForm()">
        <i class="align-middle" data-feather="plus"></i> Add Customer
    </button>
</div>

<!-- Split Screen Layout - Fixed Width Columns -->
<div class="row g-4">
    <!-- Left Side: Customer List (FIXED WIDTH, SCROLLABLE) -->
    <div class="col-lg-5 col-xl-4">
        <div class="card" style="height: calc(100vh - 200px); display: flex; flex-direction: column;">
            <div class="card-header">
                <div class="row g-2">
                    <div class="col-8">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by Name, Email, Phone, TIN..." value="@Model.SearchTerm" />
                    </div>
                    <div class="col-4">
                        <select id="typeFilter" class="form-select" asp-items="Model.CustomerTypes"></select>
                    </div>
                </div>
            </div>
            <!-- SCROLLABLE CONTAINER -->
            <div class="card-body p-0" style="flex: 1; overflow-y: auto;">
                <div id="customer-list-container">
                    @if (!Model.Customers.Any())
                    {
                        <div class="text-center py-5">
                            <i class="align-middle" data-feather="users" style="width: 48px; height: 48px;"></i>
                            <p class="mt-2 mb-0">No customers found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var customer in Model.Customers)
                            {
                                <a href="javascript:void(0)" class="list-group-item list-group-item-action customer-item" data-id="@customer.Id" onclick="loadCustomerDetails(@customer.Id)">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <strong>@customer.DisplayName</strong>
                                                <span class="badge @(customer.ConsigneeType == "Individual" ? "bg-info" : "bg-primary")">
                                                    @customer.ConsigneeType
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(customer.Email))
                                            {
                                                <div><small class="text-muted"><i class="align-middle" data-feather="mail"></i> @customer.Email</small></div>
                                            }
                                            @if (!string.IsNullOrEmpty(customer.Phone))
                                            {
                                                <div><small class="text-muted"><i class="align-middle" data-feather="phone"></i> @customer.Phone</small></div>
                                            }
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(customer.IsActive ? "bg-success" : "bg-secondary") mb-1">
                                                @(customer.IsActive ? "Active" : "Inactive")
                                            </span>
                                            <div><small class="text-muted">Orders: @customer.OrderCount</small></div>
                                            @if (customer.CurrentBalance > 0)
                                            {
                                                <div><small class="text-danger">Balance: @customer.CurrentBalance.ToString("C")</small></div>
                                            }
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Page @Model.CurrentPage of @Model.TotalPages</small>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary" onclick="previousPage()" @(Model.CurrentPage <= 1 ? "disabled" : "")>
                            <i class="align-middle" data-feather="chevron-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="nextPage()" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>
                            <i class="align-middle" data-feather="chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Form Panel (INDEPENDENT, NO SCROLL) -->
    <div class="col-lg-7 col-xl-8">
        <div id="formPanel">
            <div class="card" style="height: calc(100vh - 200px); overflow-y: auto;">
                <div class="card-body text-center py-5">
                    <i class="align-middle" data-feather="mouse-pointer" style="width: 48px; height: 48px; color: #6c757d;"></i>
                    <h5 class="mt-3">Select a customer</h5>
                    <p class="text-muted">Click on any customer to view or edit their details</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden anti-forgery token -->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function showConfirm(message, onConfirm) {
            $('#confirmModalMessage').text(message);
            $('#confirmModal').modal('show');

            $('#confirmModalOk').off('click').on('click', function () {
                $('#confirmModal').modal('hide');
                if (onConfirm) onConfirm();
            });
        }

        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';

            var toastHtml = `
                <div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" role="alert" style="z-index: 1100;">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="align-middle me-2" data-feather="${icon}"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();

            setTimeout(() => {
                $('.toast').last().remove();
            }, 3000);
        }

        var currentPage = @Model.CurrentPage;
        var searchTerm = '@Model.SearchTerm';
        var customerType = '@Model.CustomerType';

        // Load customer details into right panel
        function loadCustomerDetails(id) {
            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("DetailsPartial", "Customers")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    $('#formPanel').html(response);
                    feather.replace();
                },
                error: function() {
                    $('#loadingSpinner').fadeOut(200);
                    showToast('error', 'Error loading customer details.');
                }
            });
        }

        // Load create form
        function loadCreateForm() {
            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("CreatePartial", "Customers")',
                type: 'GET',
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    $('#formPanel').html(response);
                    feather.replace();
                    initializeCustomerTypeToggle();
                },
                error: function() {
                    $('#loadingSpinner').fadeOut(200);
                    showToast('error', 'Error loading create form.');
                }
            });
        }

        // Load edit form
        function loadEditForm(id) {
            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("EditPartial", "Customers")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    $('#formPanel').html(response);
                    feather.replace();
                    initializeCustomerTypeToggle();
                },
                error: function() {
                    $('#loadingSpinner').fadeOut(200);
                    showToast('error', 'Error loading edit form.');
                }
            });
        }

        // Initialize customer type toggle
        function initializeCustomerTypeToggle() {
            setTimeout(function() {
                var typeSelect = $('#ConsigneeType');
                if (typeSelect.length) {
                    toggleFieldsByType(typeSelect.val());
                    typeSelect.off('change').on('change', function() {
                        toggleFieldsByType($(this).val());
                    });
                }
            }, 100);
        }

        function toggleFieldsByType(type) {
            if (type === 'Individual') {
                $('.org-fields').addClass('d-none');
                $('.individual-fields').removeClass('d-none');
            } else if (type === 'Organization') {
                $('.org-fields').removeClass('d-none');
                $('.individual-fields').addClass('d-none');
            } else {
                $('.org-fields').addClass('d-none');
                $('.individual-fields').addClass('d-none');
            }
        }

        // Submit create form
        function submitCreateForm() {
            var formData = $('#createCustomerForm').serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("Create", "Customers")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    if (response.success) {
                        showToast('success', response.message);
                        refreshCustomerList();
                        loadCreateForm();
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function(xhr) {
                    $('#loadingSpinner').fadeOut(200);
                    console.error('Error:', xhr);
                    showToast('error', 'An error occurred. Please try again.');
                }
            });
        }

        // Submit edit form
        function submitEditForm() {
            var formData = $('#editCustomerForm').serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("Edit", "Customers")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    if (response.success) {
                        showToast('success', response.message);
                        refreshCustomerList();
                        $('#formPanel').html('<div class="card"><div class="card-body text-center py-5"><i class="align-middle" data-feather="check-circle" style="width: 48px; height: 48px; color: #28a745;"></i><h5 class="mt-3">Customer Updated</h5><p class="text-muted">Select a customer to continue</p></div></div>');
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function(xhr) {
                    $('#loadingSpinner').fadeOut(200);
                    console.error('Error:', xhr);
                    showToast('error', 'An error occurred. Please try again.');
                }
            });
        }

        // Delete customer - UPDATED with showConfirm
        function deleteCustomer(id, name) {
            showConfirm(`Are you sure you want to delete customer "${name}"? This action cannot be undone.`, function() {
                $('#loadingSpinner').fadeIn(200);
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Delete", "Customers")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) {
                            showToast('success', response.message);
                            refreshCustomerList();
                            $('#formPanel').html('<div class="card"><div class="card-body text-center py-5"><i class="align-middle" data-feather="trash-2" style="width: 48px; height: 48px; color: #28a745;"></i><h5 class="mt-3">Customer Deleted</h5><p class="text-muted">Select a customer to continue</p></div></div>');
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $('#loadingSpinner').fadeOut(200);
                        showToast('error', 'Error deleting customer.');
                    }
                });
            });
        }

        // Refresh customer list
        function refreshCustomerList() {
            var url = '@Url.Action("Index", "Customers")' + '?searchTerm=' + encodeURIComponent(searchTerm) + '&customerType=' + encodeURIComponent(customerType) + '&page=' + currentPage;
            window.location.href = url;
        }

        // Search and filter
        $('#typeFilter').on('change', function() {
            searchTerm = $('#searchInput').val();
            customerType = $('#typeFilter').val();
            currentPage = 1;
            refreshCustomerList();
        });

        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                searchTerm = $('#searchInput').val();
                customerType = $('#typeFilter').val();
                currentPage = 1;
                refreshCustomerList();
            }
        });

        function previousPage() {
            if (currentPage > 1) {
                currentPage--;
                refreshCustomerList();
            }
        }

        function nextPage() {
            currentPage++;
            refreshCustomerList();
        }

        // Load customer statement
        function loadCustomerStatement(id) {
            $('#loadingSpinner').fadeIn(200);
            $.ajax({
                url: '@Url.Action("StatementPartial", "Customers")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    $('#loadingSpinner').fadeOut(200);
                    $('#formPanel').html(response);
                    feather.replace();
                },
                error: function() {
                    $('#loadingSpinner').fadeOut(200);
                    showToast('error', 'Error loading customer statement.');
                }
            });
        }

        $(document).ready(function() {
            feather.replace();
        });
    </script>
}