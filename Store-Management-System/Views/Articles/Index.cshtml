@using Store_Management_System.ViewModels
@model ArticleIndexViewModel

@{
    ViewData["Title"] = "Articles";
}


<div class="mb-3 d-flex justify-content-between align-items-center">
    <h1 class="h3 d-inline align-middle">Articles</h1>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-outline-primary">
            <i class="align-middle" data-feather="upload"></i> Import Articles
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="align-middle" data-feather="plus"></i> Add New Article
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="align-middle" data-feather="search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search by Code or Name..." value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select" asp-items="Model.Categories">
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                </div>
            </div>
        </form>

        <div class="table-responsive table-scrollable">
            <table class="table table-hover my-0">
                <thead>
                    <tr>
                        <th>Article Code</th>
                        <th>Article Name</th>
                        <th>Current Stock</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Articles.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <i class="align-middle" data-feather="box" style="width: 48px; height: 48px;"></i>
                                <p class="mt-2 mb-0">No articles found. Click "Add New Article" to get started.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var article in Model.Articles)
                        {
                            <tr>
                                <td><code>@article.ArticleCode</code></td>
                                <td><strong>@article.ArticleName</strong><br /><small class="text-muted">@(article.Description?.Length > 50 ? article.Description.Substring(0, 50) + "..." : article.Description)</small></td>
                                <td>@article.CategoryName</td>
                                <td class="text-end">@article.CurrentStock</td>
                                <td>@article.StandardPrice.ToString("C")</td>
                                <td><span class="badge @(article.IsActive ? "bg-success" : "bg-danger")">@(article.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@article.Id" class="btn btn-sm btn-info" title="View"><i class="align-middle" data-feather="eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-primary" title="Edit"><i class="align-middle" data-feather="edit-2"></i></a>
                                        <a href="javascript:void(0)"
                                           class="btn btn-sm btn-danger"
                                           title="Delete"
                                           onclick="showDeleteModal(@article.Id, '@article.ArticleName')">
                                            <i class="align-middle" data-feather="trash-2"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="align-middle" data-feather="alert-triangle"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="align-middle" data-feather="trash-2" style="width: 48px; height: 48px; color: #dc3545;"></i>
                </div>
                <p class="text-center mb-0" id="deleteModalMessage">
                    Are you sure you want to delete this article?
                </p>
                <input type="hidden" id="deleteArticleId" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="align-middle" data-feather="x"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="align-middle" data-feather="trash-2"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function showConfirm(message, onConfirm) {
            $('#confirmModalMessage').text(message);
            $('#confirmModal').modal('show');

            $('#confirmModalOk').off('click').on('click', function () {
                $('#confirmModal').modal('hide');
                if (onConfirm) onConfirm();
            });
        }

        // Show delete confirmation modal using showConfirm
        function showDeleteModal(id, articleName) {
            showConfirm(`Are you sure you want to delete article "${articleName}"? This action cannot be undone.`, function() {
                // Show loading spinner
                $('#loadingSpinner').fadeIn(200);

                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "Articles")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) {
                            showToast('success', response.message);
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $('#loadingSpinner').fadeOut(200);
                        showToast('error', 'An error occurred while deleting the article.');
                    }
                });
            });
        }

        // Toast notification function (if not already present)
        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `<div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;"><div class="d-flex"><div class="toast-body"><i class="align-middle me-2" data-feather="${icon}"></i>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(function() { $('.toast').last().remove(); }, 3000);
        }

        $(document).ready(function() {
            // Any other existing initialization code
            feather.replace();
        });
    </script>

    <script>
        feather.replace();
    </script>
}