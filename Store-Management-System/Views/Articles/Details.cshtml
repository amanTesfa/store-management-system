@model Store_Management_System.Models.Article

@{
    ViewData["Title"] = "Article Details";
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 d-inline align-middle">@Model.ArticleName</h1>
        <span class="badge bg-secondary ms-2">@Model.ArticleCode</span>
    </div>
    <div class="btn-group" role="group">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="align-middle" data-feather="edit-2"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Article Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%">Article Code</th>
                        <td><code>@Model.ArticleCode</code></td>
                    </tr>
                    <tr>
                        <th>Article Name</th>
                        <td>@Model.ArticleName</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>@(Model.Description ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td>@(Model.ArticleCategoryNavigation?.Name ?? "Not assigned")</td>
                    </tr>
                    <tr>
                        <th>Article Group</th>
                        <td>@(Model.ArticleGroup ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Pricing & Units</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%">Standard Cost</th>
                        <td>@Model.StandardCost.ToString("C")</td>
                    </tr>
                    <tr>
                        <th>Standard Price</th>
                        <td>@Model.StandardPrice.ToString("C")</td>
                    </tr>
                    <tr>
                        <th>Base Unit</th>
                        <td>@(Model.BaseUnit?.UnitName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Purchase Unit</th>
                        <td>@(Model.PurchaseUnit?.UnitName ?? "Same as Base")</td>
                    </tr>
                    <tr>
                        <th>Sales Unit</th>
                        <td>@(Model.SalesUnit?.UnitName ?? "Same as Base")</td>
                    </tr>
                    <tr>
                        <th>Tax Rate</th>
                        <td>@Model.TaxRate%</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Barcodes</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.PrimaryBarcode != null)
                {
                    <div class="mb-3">
                        <strong>Primary Barcode:</strong>
                        <div class="mt-2">
                            <svg id="barcode-svg"></svg>
                        </div>
                        <code>@ViewBag.PrimaryBarcode.Barcode</code>
                    </div>
                }

                @if (ViewBag.AdditionalBarcodes != null && ((IEnumerable<dynamic>)ViewBag.AdditionalBarcodes).Any())
                {
                    <strong>Additional Barcodes:</strong>
                    <ul class="mt-2">
                        @foreach (var barcode in ViewBag.AdditionalBarcodes)
                        {
                            <li><code>@barcode.Barcode</code> (@barcode.BarcodeType)</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No additional barcodes</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        // Generate barcode for primary barcode
        @if (ViewBag.PrimaryBarcode != null)
        {
                <text>
                JsBarcode("#barcode-svg", "@ViewBag.PrimaryBarcode.Barcode", {
                    format: "CODE128",
                    width: 2,
                    height: 50,
                    displayValue: true,
                    fontSize: 14,
                    margin: 10
                });
                </text>
        }
    </script>
}