@model Voucher

@{
    ViewData["Title"] = "Purchase Order Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Purchase Order Details</h1>
    <span class="badge bg-dark text-white ms-2">@Model.VoucherNumber</span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Order Information</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">

                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%">PO Number</th>
                        <td><code>@Model.VoucherNumber</code></td>
                    </tr>
                    <tr>
                        <th>Supplier</th>
                        <td>@(Model.Supplier?.Name ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Order Date</th>
                        <td>@Model.VoucherDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                    <tr>
                        <th>Expected Date</th>
                        <td>@(Model.ExpectedDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @{
                                var statusClass = Model.Status == "Draft" ? "warning" :
                                Model.Status == "Approved" ? "info" :
                                Model.Status == "Sent" ? "primary" :
                                Model.Status == "FullyReceived" ? "success" : "secondary";
                            }
                            <span class="badge bg-@statusClass">@Model.Status</span>
                        </td>
                    </tr>
                    <tr>
                        <th>Remarks</th>
                        <td>@(Model.Remarks ?? "N/A")</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Charges & Summary</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">

                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%">Subtotal</th>
                        <td class="text-end">@Model.SubTotal.ToString("C")</td>
                    </tr>
                    @if (Model.ShippingCost.HasValue && Model.ShippingCost > 0)
                    {
                        <tr>
                            <th>Shipping</th>
                            <td class="text-end">@Model.ShippingCost.Value.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.HandlingCost.HasValue && Model.HandlingCost > 0)
                    {
                        <tr>
                            <th>Handling</th>
                            <td class="text-end">@Model.HandlingCost.Value.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.InsuranceCost.HasValue && Model.InsuranceCost > 0)
                    {
                        <tr>
                            <th>Insurance</th>
                            <td class="text-end">@Model.InsuranceCost.Value.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.OtherCost.HasValue && Model.OtherCost > 0)
                    {
                        <tr>
                            <th>Other</th>
                            <td class="text-end">@Model.OtherCost.Value.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <th>Total</th>
                        <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Line Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-scrollable">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Discount %</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.VoucherLines)
                    {
                        <tr>
                            <td>@(line.Article?.ArticleName ?? "N/A")</td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@line.UnitPrice.ToString("C")</td>
                            <td class="text-end">@line.DiscountPercent.ToString("N0")%</td>
                            <td class="text-end">@line.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Total:</td>
                        <td class="text-end fw-bold">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="align-middle" data-feather="arrow-left"></i> Back to List
    </a>
    <div>
        @if (Model.Status == "Draft")
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="align-middle" data-feather="edit-2"></i> Edit
            </a>
        }
        @if (Model.Status == "Sent" || Model.Status == "PartiallyReceived")
        {
            <a asp-controller="GoodsReceipts" asp-action="Create" asp-route-poId="@Model.Id" class="btn btn-success">
                <i class="align-middle" data-feather="package"></i> Receive Goods
            </a>
        }
    </div>
</div>