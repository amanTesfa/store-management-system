@* Tailwind-based ERP Topbar partial (non-destructive) *@
<header class="fixed left-0 right-0 top-0 h-14 flex items-center px-6 bg-white erp-topbar border-b border-slate-200 z-40">
  <div class="flex items-center gap-4">
    <button id="erp-sidebar-toggle" class="lg:hidden p-2 rounded-md bg-slate-100"><i class="bi bi-list"></i></button>
    <div class="text-lg font-manrope">@ViewData["Title"]</div>
    <div class="hidden md:block ml-6">
      <form class="flex items-center bg-slate-50 border border-slate-100 rounded-md overflow-hidden">
        <input type="text" placeholder="Search products, SKUs..." class="px-3 py-2 text-sm bg-transparent outline-none" />
        <button type="submit" class="px-3 text-slate-600"><i class="bi bi-search"></i></button>
      </form>
    </div>
  </div>

  <div class="ml-auto flex items-center gap-3">
    <button class="p-2 rounded-md text-slate-600 hover:bg-slate-50"><i class="bi bi-bell"></i></button>
    @if (User.Identity.IsAuthenticated)
    {
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gradient-to-r from-orange-400 to-red-400"></div>
        <div class="hidden sm:block text-sm text-slate-600">@User.Identity.Name</div>
        <form asp-controller="Account" asp-action="Logout" method="post">
          <button type="submit" class="ml-3 text-sm text-slate-600 hover:text-slate-800">Logout</button>
        </form>
      </div>
    }
    else
    {
      <a asp-controller="Account" asp-action="Login" class="px-3 py-1 bg-gradient-to-r from-sky-500 to-violet-500 text-white rounded-md">Login</a>
    }
  </div>
</header>