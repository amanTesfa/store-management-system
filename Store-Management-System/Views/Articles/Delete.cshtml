@model Store_Management_System.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle text-danger">Delete Product</h1>
</div>

<div class="row">
    <div class="col-12 col-lg-6 mx-auto">
        <div class="card">
            <div class="card-body text-center">
                <div class="mb-4">
                    <i class="align-middle" data-feather="alert-triangle" style="width: 64px; height: 64px; color: #e63946;"></i>
                </div>
                <h3 class="mb-3">Are you sure?</h3>
                <p class="text-muted mb-4">
                    You are about to delete <strong>@Model.Name</strong> (@Model.Sku).
                    This action cannot be undone.
                </p>

                @if (Model.CurrentStock > 0)
                {
                    <div class="alert alert-warning">
                        <i class="align-middle" data-feather="info"></i>
                        This product has @Model.CurrentStock units in stock.
                        Consider adjusting stock to zero before deletion.
                    </div>
                }

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="align-middle" data-feather="x"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="align-middle" data-feather="trash-2"></i> Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        feather.replace();
    </script>
}