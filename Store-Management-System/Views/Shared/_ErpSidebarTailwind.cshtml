@* Tailwind-based ERP Sidebar partial (non-destructive) *@
<aside class="fixed left-0 top-0 h-full bg-white border-r border-slate-200 p-6 erp-sidebar hidden lg:block">
  <div class="flex items-center gap-3 mb-6">
    <div class="brand-logo"></div>
    <div>
      <div class="text-sm font-manrope text-slate-800">Inventory Manager</div>
      <div class="text-xs text-slate-500 font-inter">ERP System</div>
    </div>
  </div>

  <nav class="space-y-2">
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Home" asp-action="Index">
      <i class="bi bi-speedometer2 text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Dashboard</span>
    </a>
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Products" asp-action="Index">
      <i class="bi bi-box-seam text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Products</span>
    </a>
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Stock" asp-action="Index">
      <i class="bi bi-archive text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Stocks & Inventory</span>
    </a>
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Orders" asp-action="Index">
      <i class="bi bi-basket text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Orders</span>
    </a>
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Suppliers" asp-action="Index">
      <i class="bi bi-truck text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Suppliers</span>
    </a>
    <a class="flex items-center gap-3 p-2 rounded-md text-slate-700 hover:bg-slate-50" asp-controller="Reports" asp-action="Index">
      <i class="bi bi-graph-up text-lg text-slate-500"></i>
      <span class="text-sm font-inter">Reports</span>
    </a>
  </nav>

  <div class="mt-6 pt-6 border-t border-slate-100 text-xs text-slate-500">
    © @DateTime.Now.Year Inventory
  </div>
</aside>