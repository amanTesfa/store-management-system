@{
    ViewData["Title"] = "Train Intent Model";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🧠 Train Intent Classification Model</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <h6>What this does:</h6>
                <p class="mb-1">Trains the ML.NET model that helps the chatbot understand what users are asking for.</p>
                <p class="mb-0">This is required for the AI chatbot to work correctly.</p>
            </div>

            <div id="modelStatus" class="mb-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Checking model status...</span>
                </div>
                Checking model status...
            </div>

            <button id="trainBtn" class="btn btn-primary" onclick="trainModel()">
                <i class="align-middle" data-feather="play"></i> Train Model
            </button>

            <div id="trainingStatus" class="mt-3 d-none">
                <div class="progress">
                    <div id="trainingProgress" class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar" style="width: 100%"></div>
                </div>
                <p class="mt-2 text-muted">Training in progress... This may take a few seconds.</p>
            </div>

            <div id="trainingResult" class="mt-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Check model status on page load
        $(document).ready(function() {
            checkModelStatus();
        });

        function checkModelStatus() {
            $.get('/AIIntelligence/GetModelInfo', function(data) {
                var html = '';
                if (data.modelExists) {
                    html += '<div class="alert alert-success">';
                    html += '<h6>✅ Model Status: Trained</h6>';
                    html += '<p class="mb-1">Last trained: ' + data.lastTrained + '</p>';
                    html += '<p class="mb-1">Model size: ' + (data.modelSize / 1024).toFixed(1) + ' KB</p>';
                    html += '<p class="mb-0">Training data rows: ' + data.dataRows + '</p>';
                    html += '</div>';
                } else {
                    html += '<div class="alert alert-warning">';
                    html += '<h6>⚠️ Model Status: Not Trained</h6>';
                    html += '<p class="mb-1">The chatbot will not work correctly until the model is trained.</p>';
                    html += '<p class="mb-0">Click "Train Model" to create the intent classifier.</p>';
                    html += '</div>';
                }
                $('#modelStatus').html(html);
            });
        }

        function trainModel() {
            $('#trainBtn').prop('disabled', true);
            $('#trainingStatus').removeClass('d-none');
            $('#trainingResult').html('');

            $.ajax({
                url: '/AIIntelligence/TrainIntentModel',
                type: 'POST',
                success: function(response) {
                    $('#trainingStatus').addClass('d-none');
                    $('#trainBtn').prop('disabled', false);

                    if (response.success) {
                        $('#trainingResult').html(
                            '<div class="alert alert-success">' +
                            '<h6>✅ ' + response.message + '</h6>' +
                            '</div>'
                        );
                        checkModelStatus();
                    } else {
                        $('#trainingResult').html(
                            '<div class="alert alert-danger">' +
                            '<h6>❌ Training Failed</h6>' +
                            '<p class="mb-0">' + response.message + '</p>' +
                            '</div>'
                        );
                    }
                },
                error: function(xhr, status, error) {
                    $('#trainingStatus').addClass('d-none');
                    $('#trainBtn').prop('disabled', false);
                    $('#trainingResult').html(
                        '<div class="alert alert-danger">' +
                        '<h6>❌ Error</h6>' +
                        '<p class="mb-0">An unexpected error occurred: ' + error + '</p>' +
                        '</div>'
                    );
                }
            });
        }
    </script>
}