@model SupplierIndexViewModel

@{
    ViewData["Title"] = "Suppliers";
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 d-inline align-middle">Suppliers</h1>
        <span class="badge bg-dark text-white ms-2">Vendor Management</span>
    </div>
    <button type="button" class="btn btn-primary" onclick="loadCreateForm()">
        <i class="align-middle" data-feather="plus"></i> Add Supplier
    </button>
</div>

<!-- Split Screen Layout -->
<div class="row g-4">
    <!-- Left Side: Supplier List -->
    <div class="col-lg-5 col-xl-4">
        <div class="card">
            <div class="card-header">
                <div class="input-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by Name, Contact, Email, Phone..." value="@Model.SearchTerm" />
                    <button class="btn btn-outline-primary" id="searchBtn">
                        <i class="align-middle" data-feather="search"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="supplier-list-container" style="max-height: 70vh; overflow-y: auto;">
                    @if (!Model.Suppliers.Any())
                    {
                        <div class="text-center py-5">
                            <i class="align-middle" data-feather="truck" style="width: 48px; height: 48px;"></i>
                            <p class="mt-2 mb-0">No suppliers found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <a href="javascript:void(0)" class="list-group-item list-group-item-action supplier-item" data-id="@supplier.Id" onclick="loadSupplierDetails(@supplier.Id)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@supplier.Name</strong>
                                            @if (!string.IsNullOrEmpty(supplier.ContactPerson))
                                            {
                                                <br />
                                                <small class="text-muted">
                                                    <i class="align-middle" data-feather="user"></i> @supplier.ContactPerson
                                                </small>
                                            }
                                        </div>
                                        <div class="text-end">
                                            @if (supplier.Rating > 0)
                                            {
                                                <div class="text-warning mb-1">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= supplier.Rating)
                                                        {
                                                            <i class="align-middle" data-feather="star"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="align-middle" data-feather="star" style="color: #dee2e6;"></i>
                                                        }
                                                    }
                                                </div>
                                            }
                                            <span class="badge @(supplier.IsActive ? "bg-success" : "bg-secondary")">
                                                @(supplier.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            <i class="align-middle" data-feather="package"></i> @supplier.ArticleCount articles
                                        </small>
                                        @if (supplier.CreditLimit.HasValue)
                                        {
                                            <small class="text-muted ms-2">
                                                <i class="align-middle" data-feather="dollar-sign"></i> Limit: @supplier.CreditLimit.Value.ToString("C")
                                            </small>
                                        }
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Page @Model.CurrentPage of @Model.TotalPages</small>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary" onclick="previousPage()" @(Model.CurrentPage <= 1 ? "disabled" : "")>
                            <i class="align-middle" data-feather="chevron-left"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="nextPage()" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>
                            <i class="align-middle" data-feather="chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Form Panel -->
    <div class="col-lg-7 col-xl-8">
        <div id="formPanel">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="align-middle" data-feather="mouse-pointer" style="width: 48px; height: 48px; color: #6c757d;"></i>
                    <h5 class="mt-3">Select a supplier</h5>
                    <p class="text-muted">Click on any supplier to view or edit its details</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden anti-forgery token -->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var currentPage = @Model.CurrentPage;
        var searchTerm = '@Model.SearchTerm';

        // Load supplier details into right panel
        function loadSupplierDetails(id) {
            $.ajax({
                url: '@Url.Action("DetailsPartial", "Suppliers")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    $('#formPanel').html(response);
                    feather.replace();
                },
                error: function() {
                    showToast('error', 'Error loading supplier details.');
                }
            });
        }

        // Load create form
        function loadCreateForm() {
            $.ajax({
                url: '@Url.Action("CreatePartial", "Suppliers")',
                type: 'GET',
                success: function(response) {
                    $('#formPanel').html(response);
                    feather.replace();
                },
                error: function() {
                    showToast('error', 'Error loading create form.');
                }
            });
        }

        // Load edit form
        function loadEditForm(id) {
            $.ajax({
                url: '@Url.Action("EditPartial", "Suppliers")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    $('#formPanel').html(response);
                    feather.replace();
                },
                error: function() {
                    showToast('error', 'Error loading edit form.');
                }
            });
        }

        // Submit create form
        function submitCreateForm() {
            var formData = $('#createSupplierForm').serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Create", "Suppliers")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    if (response.success) {
                        showToast('success', response.message);
                        refreshSupplierList();
                        loadCreateForm();
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function(xhr) {
                    console.error('Error:', xhr);
                    showToast('error', 'An error occurred. Please try again.');
                }
            });
        }

        // Submit edit form
        function submitEditForm() {
            var formData = $('#editSupplierForm').serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Edit", "Suppliers")',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                success: function(response) {
                    if (response.success) {
                        showToast('success', response.message);
                        refreshSupplierList();
                        $('#formPanel').html('<div class="card"><div class="card-body text-center py-5"><i class="align-middle" data-feather="check-circle" style="width: 48px; height: 48px; color: #28a745;"></i><h5 class="mt-3">Supplier Updated</h5><p class="text-muted">Select a supplier to continue</p></div></div>');
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function(xhr) {
                    console.error('Error:', xhr);
                    showToast('error', 'An error occurred. Please try again.');
                }
            });
        }

        // Delete supplier
        function deleteSupplier(id, name) {
            if (confirm(`Are you sure you want to delete supplier "${name}"? This action cannot be undone.`)) {
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Delete", "Suppliers")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            refreshSupplierList();
                            $('#formPanel').html('<div class="card"><div class="card-body text-center py-5"><i class="align-middle" data-feather="trash-2" style="width: 48px; height: 48px; color: #28a745;"></i><h5 class="mt-3">Supplier Deleted</h5><p class="text-muted">Select a supplier to continue</p></div></div>');
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        showToast('error', 'Error deleting supplier.');
                    }
                });
            }
        }

        // Refresh supplier list
        function refreshSupplierList() {
            var url = '@Url.Action("Index", "Suppliers")' + '?searchTerm=' + encodeURIComponent(searchTerm) + '&page=' + currentPage;
            window.location.href = url;
        }

        // Pagination
        function previousPage() {
            if (currentPage > 1) {
                currentPage--;
                refreshSupplierList();
            }
        }

        function nextPage() {
            currentPage++;
            refreshSupplierList();
        }

        // Search functionality
        $('#searchBtn').on('click', function() {
            searchTerm = $('#searchInput').val();
            currentPage = 1;
            refreshSupplierList();
        });

        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                searchTerm = $('#searchInput').val();
                currentPage = 1;
                refreshSupplierList();
            }
        });

        // Toast notification
        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';

            var toastHtml = `
                <div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" role="alert" style="z-index: 1100;">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="align-middle me-2" data-feather="${icon}"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();

            setTimeout(() => {
                $('.toast').last().remove();
            }, 3000);
        }

        $(document).ready(function() {
            feather.replace();
        });
    </script>
}