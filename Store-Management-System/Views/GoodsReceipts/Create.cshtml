@model GoodsReceiptViewModel

@{
    ViewData["Title"] = "Create Goods Receipt";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Create Goods Receipt</h1>
    <span class="badge bg-dark text-white ms-2">Receive Stock</span>
</div>

<form id="mainForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VoucherNumber" />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Receipt Information</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="PurchaseOrderId" class="form-label">Purchase Order *</label>
                        <select asp-for="PurchaseOrderId" class="form-select" id="PurchaseOrderId" asp-items="Model.PurchaseOrders">
                            <option value="">-- Select PO --</option>
                        </select>
                        <span asp-validation-for="PurchaseOrderId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReceiptDate" class="form-label">Receipt Date *</label>
                        <input asp-for="ReceiptDate" class="form-control" type="date" />
                        <span asp-validation-for="ReceiptDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Summary</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" id="poInfo">
                        Select a Purchase Order to see details.
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Total Received Value:</strong>
                        <strong id="totalValueDisplay">$0.00</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5 class="card-title mb-0">Items to Receive</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Ordered</th>
                            <th>Previously Received</th>
                            <th>Available</th>
                            <th>To Receive</th>
                            <th>Unit Price</th>
                            <th>Accept?</th>
                            <th>Batch/Serial</th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Select a Purchase Order to load items.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="align-middle" data-feather="save"></i> Post Goods Receipt
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $('#PurchaseOrderId').on('change', function() {
            var poId = $(this).val();
            if (poId) {
                $.ajax({
                    url: '@Url.Action("GetPOLines", "GoodsReceipts")',
                    type: 'GET',
                    data: { poId: poId },
                    success: function(response) {
                        if (response.success) {
                            loadPOLines(response);
                        } else {
                            $('#itemsBody').html('<tr><td colspan="8" class="text-center py-4 text-danger">Failed to load PO lines.</td></tr>');
                        }
                    }
                });
            } else {
                $('#itemsBody').html('<tr><td colspan="8" class="text-center py-4 text-muted">Select a Purchase Order to load items.</td></tr>');
                $('#poInfo').html('Select a Purchase Order to see details.');
            }
        });

        function loadPOLines(data) {
            var html = '';
            var index = 0;

            $('#poInfo').html(`<strong>PO #${data.poNumber}</strong><br />Warehouse ID: ${data.warehouseId}`);

            for (var i = 0; i < data.lines.length; i++) {
                var line = data.lines[i];
                if (line.availableToReceive <= 0) continue;

                html += `
                    <tr class="receipt-line" data-index="${index}">
                        <input type="hidden" name="Lines[${index}].PurchaseOrderLineId" value="${line.lineId}" />
                        <input type="hidden" name="Lines[${index}].ArticleId" value="${line.articleId}" />
                        <input type="hidden" name="Lines[${index}].UnitPrice" value="${line.unitPrice}" />
                        <input type="hidden" name="Lines[${index}].AvailableToReceive" value="${line.availableToReceive}" />
                        <input type="hidden" name="Lines[${index}].PreviouslyReceived" value="${line.previouslyReceived}" />
                        <td>
                            <strong>${line.articleCode}</strong><br />
                            <small class="text-muted">${line.articleName}</small>
                        </td>
                        <td class="text-end">${line.orderedQuantity}</td>
                        <td class="text-end">${line.previouslyReceived}</td>
                        <td class="text-end text-primary">${line.availableToReceive}</td>
                        <td>
                            <input type="number" name="Lines[${index}].QuantityToReceive"
                                   class="form-control receive-qty" style="width: 100px;"
                                   value="0" min="0" max="${line.availableToReceive}"
                                   onchange="validateQuantity(this, ${line.availableToReceive}, ${index})" />
                        </td>
                        <td class="text-end">${line.unitPrice.toFixed(2)}</td>
                        <td class="text-center">
                            <div class="form-check">
                                 <input type="checkbox" name="Lines[${index}].IsAccepted" class="form-check-input accept-check" value="true" checked onchange="toggleAccept(${index}, this)" />
                                 <input type="hidden" name="Lines[${index}].IsAccepted" value="false" />
                            </div>
                        </td>
                        <td>
                            ${line.isBatchTracked ? `<input type="text" name="Lines[${index}].BatchNumber" class="form-control form-control-sm mb-1" placeholder="Batch #" />` : ''}
                            ${line.isSerialized ? `<input type="text" name="Lines[${index}].SerialNumber" class="form-control form-control-sm mb-1" placeholder="Serial #" />` : ''}
                            ${line.isExpiryTracked ? `<input type="date" name="Lines[${index}].ExpiryDate" class="form-control form-control-sm" />` : ''}
                         </td>
                     </tr>
                `;
                index++;
            }

            if (index === 0) {
                html = '<tr><td colspan="8" class="text-center py-4 text-muted">No items available to receive for this PO.</td></tr>';
            }

            $('#itemsBody').html(html);
            calculateTotalValue();
        }

        function validateQuantity(input, maxAvailable, index) {
            var value = parseFloat($(input).val()) || 0;
            if (value > maxAvailable) {
                $(input).val(maxAvailable);
                showToast('warning', `Cannot receive more than available (${maxAvailable})`);
            }
            if (value < 0) $(input).val(0);
            calculateTotalValue();
        }

        function toggleAccept(index, checkbox) {
            var isChecked = $(checkbox).is(':checked');
            var qtyInput = $(`input[name="Lines[${index}].QuantityToReceive"]`);

            if (!isChecked) {
                qtyInput.val(0).prop('disabled', true);
                var reason = prompt('Please enter rejection reason:');
                if (reason) {
                    $(`<input type="hidden" name="Lines[${index}].RejectionReason" value="${reason}" />`).appendTo(`tr[data-index="${index}"]`);
                }
            } else {
                var maxAvailable = $(`input[name="Lines[${index}].AvailableToReceive"]`).val();
                qtyInput.val(maxAvailable).prop('disabled', false);
            }
            calculateTotalValue();
        }

        function calculateTotalValue() {
            var total = 0;
            $('.receipt-line').each(function() {
                var qty = parseFloat($(this).find('.receive-qty').val()) || 0;
                var price = parseFloat($(this).find('input[name$=".UnitPrice"]').val()) || 0;
                var isAccepted = $(this).find('.accept-check').is(':checked');
                if (isAccepted && qty > 0) {
                    total += qty * price;
                }
            });
            $('#totalValueDisplay').text('$' + total.toFixed(2));
        }

        function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `<div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;"><div class="d-flex"><div class="toast-body"><i class="align-middle me-2" data-feather="${icon}"></i>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(() => { $('.toast').last().remove(); }, 3000);
        }

        $(document).ready(function() {
            feather.replace();
        });
    </script>
}