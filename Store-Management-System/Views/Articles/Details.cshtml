@model Store_Management_System.Models.Article

@{
    ViewData["Title"] = "Article Details";
}
<!-- Stock Status Card - Add this at the top of your details page -->

<!-- Stock Movements History -->
<!-- Stock Movements History -->
<div class="card mt-3">
    <div class="row">
        <!-- Left Column -->
        <div class="col-md-6">
            <div class="card-header">
                <h5 class="card-title mb-0">Recent Stock Movements</h5>
            </div>
            <div class="table-responsive table-scrollable">
                <table class="table table-hover my-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Type</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end">Total</th>
                            <th>Warehouse</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentMovements == null || !((IEnumerable<dynamic>)ViewBag.RecentMovements).Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-3">No stock movements recorded</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var movement in ViewBag.RecentMovements)
                            {
                                <tr>
                                    <td>@movement.MovementDate.ToString("MMM dd, yyyy")</td>
                                    <td><code>@movement.Reference</code></td>
                                    <td>
                                        <span class="badge @(movement.Quantity > 0 ? "bg-success" : "bg-danger")">
                                            @movement.MovementType
                                        </span>
                                    </td>
                                    <td class="text-end @(movement.Quantity > 0 ? "text-success" : "text-danger")">
                                        @(movement.Quantity > 0 ? $"+{movement.Quantity}" : movement.Quantity.ToString())
                                    </td>
                                    <td class="text-end">@movement.UnitCost.ToString("C")</td>
                                    <td class="text-end">@((movement.Quantity * movement.UnitCost).ToString("C"))</td>
                                    <td>@movement.WarehouseName</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>  

        <!-- Right Column -->
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Stock Status</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <h3 class="display-4 fw-bold text-primary">@ViewBag.CurrentStock</h3>
                            <span class="badge @(ViewBag.CurrentStock <= 0 ? "bg-danger" : (ViewBag.CurrentStock <= ViewBag.ReorderLevel ? "bg-warning" : "bg-success")) fs-6">
                                @(ViewBag.CurrentStock <= 0 ? "Out of Stock" : (ViewBag.CurrentStock <= ViewBag.ReorderLevel ? "Low Stock" : "In Stock"))
                            </span>
                        </div>
                        <div class="col-md-8">
                            @if (ViewBag.MaxStockLevel > 0)
                            {
                                var percentage = (ViewBag.CurrentStock / (decimal)ViewBag.MaxStockLevel) * 100;
                                <div class="mb-2">
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar @(ViewBag.CurrentStock <= ViewBag.ReorderLevel ? "bg-warning" : "bg-success")"
                                             role="progressbar" style="width: @percentage%">
                                        </div>
                                    </div>
                                    <small class="text-muted">@ViewBag.CurrentStock / @ViewBag.MaxStockLevel units</small>
                                </div>
                            }

                            @if (ViewBag.CurrentStock <= ViewBag.ReorderLevel && ViewBag.CurrentStock > 0)
                            {
                                <div class="alert alert-warning mt-2 mb-0 py-2">
                                    <i class="align-middle" data-feather="alert-triangle"></i>
                                    Reorder level: @ViewBag.ReorderLevel | Need to reorder @(ViewBag.ReorderLevel - ViewBag.CurrentStock) units
                                </div>
                            }
                            else if (ViewBag.CurrentStock == 0)
                            {
                                <div class="alert alert-danger mt-2 mb-0 py-2">
                                    <i class="align-middle" data-feather="alert-circle"></i>
                                    Product is out of stock! Reorder immediately.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 d-inline align-middle">@Model.ArticleName</h1>
        <span class="badge bg-secondary ms-2">@Model.ArticleCode</span>
    </div>
    <div class="btn-group" role="group">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="align-middle" data-feather="edit-2"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Article Information</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable table-responsive table-scrollable">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%">Article Code</th>
                        <td><code>@Model.ArticleCode</code></td>
                    </tr>
                    <tr>
                        <th>Article Name</th>
                        <td>@Model.ArticleName</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>@(Model.Description ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td>@(Model.ArticleCategoryNavigation?.Name ?? "Not assigned")</td>
                    </tr>
                    <tr>
                        <th>Article Group</th>
                        <td>@(Model.ArticleGroup ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Pricing & Units</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive table-scrollable">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%">Standard Cost</th>
                        <td>@Model.StandardCost.ToString("C")</td>
                    </tr>
                    <tr>
                        <th>Standard Price</th>
                        <td>@Model.StandardPrice.ToString("C")</td>
                    </tr>
                    <tr>
                        <th>Base Unit</th>
                        <td>@(Model.BaseUnit?.UnitName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Purchase Unit</th>
                        <td>@(Model.PurchaseUnit?.UnitName ?? "Same as Base")</td>
                    </tr>
                    <tr>
                        <th>Sales Unit</th>
                        <td>@(Model.SalesUnit?.UnitName ?? "Same as Base")</td>
                    </tr>
                    <tr>
                        <th>Tax Rate</th>
                        <td>@Model.TaxRate%</td>
                    </tr>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Barcodes</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.PrimaryBarcode != null)
                {
                    <div class="mb-3">
                        <strong>Primary Barcode:</strong>
                        <div class="mt-2">
                            <svg id="barcode-svg"></svg>
                        </div>
                        <code>@ViewBag.PrimaryBarcode.Barcode</code>
                    </div>
                }

                @if (ViewBag.AdditionalBarcodes != null && ((IEnumerable<dynamic>)ViewBag.AdditionalBarcodes).Any())
                {
                    <strong>Additional Barcodes:</strong>
                    <ul class="mt-2">
                        @foreach (var barcode in ViewBag.AdditionalBarcodes)
                        {
                            <li><code>@barcode.Barcode</code> (@barcode.BarcodeType)</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">No additional barcodes</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        // Generate barcode for primary barcode
        @if (ViewBag.PrimaryBarcode != null)
        {
                <text>
                JsBarcode("#barcode-svg", "@ViewBag.PrimaryBarcode.Barcode", {
                    format: "CODE128",
                    width: 2,
                    height: 50,
                    displayValue: true,
                    fontSize: 14,
                    margin: 10
                });
                </text>
        }
    </script>
}