@model WarehouseIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group w-50">
        <input type="text" id="warehouseSearch" class="form-control" placeholder="Search warehouses..." value="@Model.SearchTerm" />
        <button class="btn btn-outline-primary" id="searchWarehouseBtn">
            <i class="align-middle" data-feather="search"></i>
        </button>
    </div>
    <button type="button" class="btn btn-primary" onclick="openWarehouseModal(0)">
        <i class="align-middle" data-feather="plus"></i> Add Warehouse
    </button>
</div>

<div class="table-responsive table-scrollable">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Type</th>
                <th>Location</th>
                <th>Default</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model.Warehouses)
            {
                <tr>
                    <td><code>@w.WarehouseCode</code></td>
                    <td><strong>@w.WarehouseName</strong></td>
                    <td>@(w.WarehouseType ?? "-")</td>
                    <td>@(w.Location ?? "-")</td>
                    <td>@(w.IsDefault ? "✓" : "")</td>
                    <td><span class="badge @(w.IsActive ? "bg-success" : "bg-secondary")">@(w.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick="openWarehouseModal(@w.Id)" title="Edit">
                            <i class="align-middle" data-feather="edit-2"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteWarehouse(@w.Id, '@w.WarehouseName')" title="Delete">
                            <i class="align-middle" data-feather="trash-2"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3 d-flex justify-content-between">
    <small>Page @Model.CurrentPage of @Model.TotalPages</small>
    <div>
        <button class="btn btn-sm btn-outline-secondary" onclick="changeWarehousePage(@Model.CurrentPage - 1)" @(Model.CurrentPage <= 1 ? "disabled" : "")>Previous</button>
        <button class="btn btn-sm btn-outline-secondary" onclick="changeWarehousePage(@Model.CurrentPage + 1)" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>Next</button>
    </div>
</div>

<script>
    var warehousePage = @Model.CurrentPage;
    var warehouseSearch = '@Model.SearchTerm';

    function refreshWarehouses() {
        var url = '@Url.Action("WarehousesList", "SystemSetup")?searchTerm=' + encodeURIComponent(warehouseSearch) + '&page=' + warehousePage;
        $.ajax({ url: url, success: function(r) { $('#warehousesContent').html(r); feather.replace(); } });
    }

    function changeWarehousePage(page) { warehousePage = page; refreshWarehouses(); }
    $('#warehouseSearch').on('keypress', function(e) { if (e.which === 13) { warehouseSearch = $(this).val(); warehousePage = 1; refreshWarehouses(); } });
    $('#searchWarehouseBtn').on('click', function() { warehouseSearch = $('#warehouseSearch').val(); warehousePage = 1; refreshWarehouses(); });
</script>