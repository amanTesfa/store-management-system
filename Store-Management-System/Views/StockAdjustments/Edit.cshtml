@model StockAdjustmentViewModel

@{
    ViewData["Title"] = "Edit Stock Adjustment";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Edit Stock Adjustment</h1>
    <span class="badge bg-dark text-white ms-2">@Model.AdjustmentNumber</span>
</div>

<form id="mainForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AdjustmentNumber" />
    <input type="hidden" asp-for="Status" />

    <!-- BASIC INFO -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><h5>Adjustment Info</h5></div>
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="WarehouseId"></label>
                        <select asp-for="WarehouseId" class="form-select" id="WarehouseId" asp-items="Model.Warehouses"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AdjustmentDate"></label>
                        <input asp-for="AdjustmentDate" type="date" class="form-control" />
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><h5>Summary</h5></div>
                <div class="card-body">
                    <strong>Total Value:</strong>
                    <span id="totalValueDisplay">$0.00</span>
                    <br />
                    <strong>Total Items:</strong>
                    <span id="totalItemsDisplay">0</span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between">
            <h5>Products</h5>
            <button type="button" class="btn btn-primary btn-sm" onclick="addLine()">Add</button>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>System Qty</th>
                        <th>Physical Qty</th>
                        <th>Variance</th>
                        <th>Unit Cost</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody id="itemsBody">
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <tr class="line-item" data-index="@i">

                            <td>
                                <select name="Lines[@i].ArticleId" class="form-select product-select" data-index="@i" onchange="loadProductStock(@i)">
                                    <option value="">Select</option>
                                    @foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Value" selected="@(line.ArticleId.ToString() == p.Value)">
                                            @p.Text
                                        </option>
                                    }
                                </select>
                                <input type="hidden" class="unit-cost-@i" value="@line.UnitCost" />
                            </td>

                            <td>
                                <input type="number" class="form-control system-qty" value="@line.SystemQuantity" readonly />
                            </td>

                            <td>
                                <input type="number" class="form-control physical-qty" value="@line.PhysicalQuantity" onchange="updateLineVariance(@i)" />
                            </td>

                            <td class="variance-@i text-end">0</td>
                            <td class="unit-cost-display-@i text-end">$0.00</td>
                            <td class="line-total-@i text-end">$0.00</td>

                            <td>
                                <button type="button" class="btn btn-danger btn-sm" onclick="removeLine(this)">X</button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-success">Save</button>
    </div>
</form>

@section Scripts {
    <script>
        let lineCounter = @Model.Lines.Count;
        let warehouseId = @Model.WarehouseId;

        function addLine() {

            let index = lineCounter;

            let row = `
            <tr class="line-item" data-index="${index}">
                <td>
                    <select name="Lines[${index}].ArticleId" class="form-select">
                        <option>Select</option>
                    </select>
                    <input type="hidden" class="unit-cost-${index}" value="0" />
                </td>

                <td><input type="number" class="form-control system-qty" value="0" readonly /></td>
                <td><input type="number" class="form-control physical-qty" onchange="updateLineVariance(${index})" /></td>

                <td class="variance-${index}">0</td>
                <td class="unit-cost-display-${index}">$0.00</td>
                <td class="line-total-${index}">$0.00</td>

                <td><button type="button" onclick="removeLine(this)">X</button></td>
            </tr>`;

            $('#itemsBody').append(row);
            lineCounter++;
        }

        function updateLineVariance(index) {

            let systemQty = parseFloat($('.system-qty').eq(index).val()) || 0;
            let physicalQty = parseFloat($('.physical-qty').eq(index).val()) || 0;
            let cost = parseFloat($('.unit-cost-' + index).val()) || 0;

            let variance = physicalQty - systemQty;
            let total = variance * cost;

            $('.variance-' + index).text(variance);
            $('.line-total-' + index).text('$' + total.toFixed(2));

            updateSummary();
        }

        function removeLine(btn) {
            $(btn).closest('tr').remove();
            updateSummary();
        }

        function updateSummary() {

            let total = 0;
            let count = 0;

            $('.line-item').each(function () {

                let variance = parseFloat($(this).find('[class^="variance"]').text()) || 0;
                let cost = 1;

                if (variance !== 0) {
                    count++;
                    total += variance * cost;
                }
            });

            $('#totalItemsDisplay').text(count);
            $('#totalValueDisplay').text('$' + total.toFixed(2));
        }

        $(document).ready(function () {
            updateSummary();
        });
    </script>
}