@model List<ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}
<style>
    #chatToggleBtn {
        display: block !important;
        background-color: #0d6efd !important;
    }
</style>
<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Activity Logs</h1>
    <span class="badge bg-dark text-white ms-2">Audit Trail</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive table-scrollable">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%">Date/Time</th>
                        <th style="width: 10%">User</th>
                        <th style="width: 8%">Action</th>
                        <th style="width: 12%">Entity</th>
                        <th style="width: 35%">Details</th>
                        <th style="width: 10%">IP Address</th>
                        <th style="width: 10%">Entity ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="align-middle" data-feather="clock" style="width: 48px; height: 48px;"></i>
                                <p class="mt-2 mb-0">No activity logs found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var actionClass = log.Action == "Create" ? "bg-success" :
                                             log.Action == "Edit" ? "bg-primary" :
                                             log.Action == "Delete" ? "bg-danger" :
                                             log.Action == "Approve" ? "bg-info" :
                                             log.Action == "Post" ? "bg-dark" :
                                             log.Action == "Cancel" ? "bg-warning" : "bg-secondary";
                            <tr>
                                <td><small>@log.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")</small></td>
                                <td><strong>@log.UserName</strong></td>
                                <td><span class="badge @actionClass">@log.Action</span></td>
                                <td>@log.EntityType</td>
                                <td>
                                    <small>@log.Details</small>
                                    @if (!string.IsNullOrEmpty(log.NewValue) && log.NewValue.Length > 100)
                                    {
                                        <br />
                                        <a href="#" onclick="showJsonPreview(@log.Id)">View details</a>
                                    }
                                 
                                <td><code>@(log.IpAddress ?? "-")</code></td>
                                <td>@(log.EntityId?.ToString() ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JSON Preview Modal -->

<div class="modal fade" id="jsonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Record Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="jsonTableContent" style="max-height: 400px; overflow: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                // Chat functionality
       

                       function showJsonPreview(id) {
            $('#jsonModal').modal('show');
            $('#jsonTableContent').html('<div class="text-center p-4">Loading...</div>');

            $.ajax({
                url: '@Url.Action("GetLogDetails", "ActivityLogs")',
                type: 'GET',
                data: { id: id },
                dataType: 'text',  // Force text response
                success: function(response) {
                    console.log("Raw response:", response);

                    try {
                        var data = JSON.parse(response);
                        console.log("Parsed data:", data);

                        var html = '<table class="table table-bordered table-sm">';
                        for (var key in data) {
                            if (data.hasOwnProperty(key)) {
                                var value = data[key];
                                if (value === null) value = '(null)';
                                if (typeof value === 'object') value = JSON.stringify(value);
                                html += '<tr>';
                                html += '<th style="width: 35%; background: #f5f5f5;">' + key + '</th>';
                                html += '<td>' + value + '</td>';
                                html += '</tr>';
                            }
                        }
                        html += '</table>';
                        $('#jsonTableContent').html(html);
                    } catch(e) {
                        console.error('Parse error:', e);
                        $('#jsonTableContent').html('<pre class="p-3">' + response + '</pre>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX error:', error);
                    $('#jsonTableContent').html('<div class="alert alert-danger">Unable to load details: ' + error + '</div>');
                }
            });
        }
    </script>
}