@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get real data from ViewBag (set in controller)
}

<!-- Page Title -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><strong>Analytics</strong> Dashboard</h1>
    <div>
        <button class="btn btn-outline-secondary" onclick="window.location.reload()">
            <i class="align-middle" data-feather="refresh-cw"></i> Refresh
        </button>
    </div>
</div>

<!-- Stats Cards Row -->
<div class="row">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Total Products</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-primary">
                            <i class="align-middle" data-feather="box"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3">@ViewBag.TotalProducts</h1>
                <div class="mb-0">
                    <span class="text-success">@ViewBag.ActiveProducts%</span>
                    <span class="text-muted">Active products</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Low Stock</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-warning">
                            <i class="align-middle" data-feather="alert-triangle"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3">@ViewBag.LowStockCount</h1>
                <div class="mb-0">
                    <span class="text-danger">@ViewBag.OutOfStockCount</span>
                    <span class="text-muted">Out of stock</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">Inventory Value</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-success">
                            <i class="align-middle" data-feather="dollar-sign"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3">@ViewBag.TotalInventoryValue.ToString("N0")</h1>
                <div class="mb-0">
                    <span class="text-success">@ViewBag.TotalStockQuantity</span>
                    <span class="text-muted">Total units</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col mt-0">
                        <h5 class="card-title">This Month Sales</h5>
                    </div>
                    <div class="col-auto">
                        <div class="stat text-info">
                            <i class="align-middle" data-feather="shopping-cart"></i>
                        </div>
                    </div>
                </div>
                <h1 class="mt-1 mb-3">@ViewBag.MonthlySalesCount</h1>
                <div class="mb-0">
                    <span class="text-success">@ViewBag.MonthlySalesValue.ToString("C")</span>
                    <span class="text-muted">Revenue</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row">
    <!-- Stock Movement Chart -->
    <div class="col-xl-6 col-xxl-7">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Stock Movement (Last 6 Months)</h5>
            </div>
            <div class="card-body py-3">
                <div class="chart chart-sm">
                    <canvas id="stockMovementChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock by Category Pie Chart -->
    <div class="col-12 col-md-6 col-xxl-3 d-flex order-2 order-xxl-3">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Stock by Category</h5>
            </div>
            <div class="card-body d-flex">
                <div class="align-self-center w-100">
                    <div class="py-3">
                        <div class="chart chart-xs">
                            <canvas id="categoryPieChart"></canvas>
                        </div>
                    </div>
                    <div id="categoryLegend" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendar -->
    <div class="col-12 col-md-6 col-xxl-2 d-flex order-1 order-xxl-1">
        <div class="card flex-fill">
            <div class="card-header">
                <h5 class="card-title mb-0">Calendar</h5>
            </div>
            <div class="card-body d-flex">
                <div class="align-self-center w-100">
                    <div id="datetimepicker-dashboard"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="row">
    <div class="col-12 col-lg-8 col-xxl-9 d-flex">
        <div class="card flex-fill">
            <div class="card-header">
                <h5 class="card-title mb-0">Recent Sales Orders</h5>
            </div>
            <div class="table-responsive table-scrollable">
                <table class="table table-hover my-0">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
                        {
                            @foreach (var order in ViewBag.RecentOrders)
                            {
                                <tr>
                                    <td><code>@order.VoucherNumber</code></td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge @(order.Status == "Completed" ? "bg-success" : order.Status == "Shipped" ? "bg-info" : order.Status == "Approved" ? "bg-primary" : "bg-warning")">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3">No recent orders</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top Products Bar Chart -->
    <div class="col-12 col-lg-4 col-xxl-3 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Top Selling Products</h5>
            </div>
            <div class="card-body d-flex w-100">
                <div class="align-self-center chart chart-lg w-100">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Stock Movement Chart
            var ctx = document.getElementById("stockMovementChart").getContext("2d");
            var months = @Html.Raw(Json.Serialize(ViewBag.MovementMonths));
            var inData = @Html.Raw(Json.Serialize(ViewBag.MovementIn));
            var outData = @Html.Raw(Json.Serialize(ViewBag.MovementOut));
            
            new Chart(ctx, {
                type: "line",
                data: {
                    labels: months,
                    datasets: [
                        {
                            label: "Stock In",
                            data: inData,
                            borderColor: "#28a745",
                            backgroundColor: "rgba(40,167,69,0.1)",
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: "Stock Out",
                            data: outData,
                            borderColor: "#dc3545",
                            backgroundColor: "rgba(220,53,69,0.1)",
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: "top" },
                        tooltip: { callbacks: { label: function(context) { return context.dataset.label + ": " + context.raw.toFixed(0) + " units"; } } }
                    },
                    scales: { y: { beginAtZero: true, title: { display: true, text: "Quantity" } } }
                }
            });

            // Category Pie Chart
            var categoryCtx = document.getElementById("categoryPieChart").getContext("2d");
            var categoryNames = @Html.Raw(Json.Serialize(ViewBag.CategoryNames));
            var categoryValues = @Html.Raw(Json.Serialize(ViewBag.CategoryValues));
            var categoryColors = ['#4361ee', '#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6f42c1', '#fd7e14', '#20c997'];
            
            var pieChart = new Chart(categoryCtx, {
                type: "pie",
                data: {
                    labels: categoryNames,
                    datasets: [{
                        data: categoryValues,
                        backgroundColor: categoryColors.slice(0, categoryNames.length),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            // Generate custom legend
            var legendHtml = '<div class="row g-2">';
            for (var i = 0; i < categoryNames.length; i++) {
                legendHtml += '<div class="col-6"><span style="display:inline-block;width:12px;height:12px;background:' + categoryColors[i] + ';border-radius:2px;margin-right:5px;"></span> ' + categoryNames[i] + ' (' + categoryValues[i].toFixed(0) + ')</div>';
            }
            legendHtml += '</div>';
            document.getElementById('categoryLegend').innerHTML = legendHtml;

            // Top Products Chart
            var productsCtx = document.getElementById("topProductsChart").getContext("2d");
            var productNames = @Html.Raw(Json.Serialize(ViewBag.TopProductNames));
            var productQuantities = @Html.Raw(Json.Serialize(ViewBag.TopProductQuantities));
            
            new Chart(productsCtx, {
                type: "bar",
                data: {
                    labels: productNames,
                    datasets: [{
                        label: "Units Sold",
                        data: productQuantities,
                        backgroundColor: "#4361ee",
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { title: { display: true, text: "Quantity Sold" } } }
                }
            });

            // Calendar
            flatpickr("#datetimepicker-dashboard", {
                inline: true,
                prevArrow: "<span title='Previous month'>&laquo;</span>",
                nextArrow: "<span title='Next month'>&raquo;</span>"
            });
        });
    </script>
}