@model Store_Management_System.ViewModels.ReturnToSupplierViewModel

@{
    ViewData["Title"] = "Return Details";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Return Details</h1>
    <span class="badge bg-dark text-white ms-2">RTV</span>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Return Information</h5>
    </div>
    <div class="card-body">
        <div class="row gy-2">
            <div class="col-md-3">
                <label class="form-label">Return Number</label>
                <p class="form-control-plaintext"><code>@Model.ReturnNumber</code></p>
            </div>
            <div class="col-md-3">
                <label class="form-label">Original GRN</label>
                <p class="form-control-plaintext">@Model.OriginalReceiptNumber</p>
            </div>
            <div class="col-md-3">
                <label class="form-label">Supplier</label>
                <p class="form-control-plaintext">@Model.SupplierName</p>
            </div>
            <div class="col-md-3">
                <label class="form-label">Return Date</label>
                <p class="form-control-plaintext">@Model.ReturnDate.ToString("yyyy-MM-dd")</p>
            </div>
            <div class="col-12 mt-2">
                <label class="form-label">Reason / Remarks</label>
                <p class="form-control-plaintext">@Model.ReturnReason<br />@Model.Remarks</p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5 class="card-title mb-0">Returned Items</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Cost</th>
                        <th>Total</th>
                        <th>Reason</th>
                        <th>Batch</th>
                        <th>Serial</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines == null || !Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No items on this return.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td><strong>@line.ArticleCode</strong><br /><small>@line.ArticleName</small></td>
                                <td class="text-end">@line.QuantityToReturn</td>
                                <td class="text-end">@line.UnitCost.ToString("C")</td>
                                <td class="text-end">@( (line.QuantityToReturn * line.UnitCost).ToString("C") )</td>
                                <td>@line.Reason</td>
                                <td>@line.BatchNumber</td>
                                <td>@line.SerialNumber</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-start">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="align-middle" data-feather="arrow-left"></i> Back to Returns
    </a>
</div>

@section Scripts {
    <script>
        feather.replace();
    </script>
}
