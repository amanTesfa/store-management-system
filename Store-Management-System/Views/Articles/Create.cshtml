@model Store_Management_System.ViewModels.ArticleCreateViewModel
@{
    ViewData["Title"] = "Add New Article";
}

<div class="mb-3">
    <h1 class="h3 d-inline align-middle">Add New Article</h1>
    <span class="badge bg-dark text-white ms-2">Inventory</span>
</div>

<form asp-action="Create" method="post" id="articleForm">
    <div class="row">
        <div class="col-12 col-lg-6">
            <!-- Article Information Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Article Information</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ArticleCode" class="form-label">Article Code</label>
                                <input asp-for="ArticleCode" class="form-control" readonly style="background-color: #e9ecef; font-family: monospace;" />
                                <small class="text-muted">Auto-generated: ART-DDMMYY-XXXX</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PrimaryBarcode" class="form-label">Primary Barcode</label>
                                <input asp-for="PrimaryBarcode" class="form-control" id="PrimaryBarcode" />
                                <small class="text-muted">For scanning at POS. Same as Article Code by default.</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ArticleName" class="form-label">Article Name *</label>
                        <input asp-for="ArticleName" class="form-control" />
                        <span asp-validation-for="ArticleName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ArticleCategory" class="form-label">Category *</label>
                                <select asp-for="ArticleCategory" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="ArticleCategory" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ArticleGroup" class="form-label">Article Group</label>
                                <input asp-for="ArticleGroup" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Units Card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Units of Measure</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="BaseUnitId" class="form-label">Base Unit *</label>
                                <select asp-for="BaseUnitId" class="form-select" asp-items="ViewBag.BaseUnits">
                                    <option value="">-- Select Unit --</option>
                                </select>
                                <span asp-validation-for="BaseUnitId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PurchaseUnitId" class="form-label">Purchase Unit</label>
                                <select asp-for="PurchaseUnitId" class="form-select" asp-items="ViewBag.PurchaseUnits">
                                    <option value="">-- Same as Base --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SalesUnitId" class="form-label">Sales Unit</label>
                                <select asp-for="SalesUnitId" class="form-select" asp-items="ViewBag.SalesUnits">
                                    <option value="">-- Same as Base --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <!-- Pricing Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Pricing</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StandardCost" class="form-label">Standard Cost *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="StandardCost" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="StandardCost" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StandardPrice" class="form-label">Standard Price *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="StandardPrice" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="StandardPrice" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                                <input asp-for="ReorderLevel" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SafetyStock" class="form-label">Safety Stock</label>
                                <input asp-for="SafetyStock" class="form-control" type="number" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="MaxStockLevel" class="form-label">Max Stock Level</label>
                                <input asp-for="MaxStockLevel" class="form-control" type="number" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TaxRate" class="form-label">Tax Rate (%)</label>
                                <input asp-for="TaxRate" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TaxGroup" class="form-label">Tax Group</label>
                                <input asp-for="TaxGroup" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Barcode Preview Card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Barcode Preview</h5>
                </div>
                <div class="card-body text-center">
                    <div id="barcode-container" class="p-3 bg-light rounded">
                        <svg id="barcode-svg"></svg>
                    </div>
                    <small class="text-muted">Barcode will be generated based on Primary Barcode</small>
                </div>
            </div>

            <!-- Additional Barcodes Card -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Additional Barcodes</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBarcodeField()">
                        <i class="align-middle" data-feather="plus"></i> Add
                    </button>
                </div>
                <div class="card-body">
                    <div id="barcodes-list">
                        @for (int i = 0; i < Model.AdditionalBarcodes.Count; i++)
                        {
                            <div class="input-group mb-2 barcode-field">
                                <input asp-for="AdditionalBarcodes[i]" class="form-control" placeholder="Enter additional barcode" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeBarcodeField(this)">
                                    <i class="align-middle" data-feather="x"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <small class="text-muted">Add alternative barcodes (UPC, EAN, etc.) for this article</small>
                </div>
            </div>

            <!-- Status Flags Card -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Status & Tracking</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked>
                                <label asp-for="IsActive" class="form-check-label">Active Article</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsStockable" class="form-check-input" type="checkbox" role="switch" checked>
                                <label asp-for="IsStockable" class="form-check-label">Stockable</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsPurchasable" class="form-check-input" type="checkbox" role="switch" checked>
                                <label asp-for="IsPurchasable" class="form-check-label">Purchasable</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsSellable" class="form-check-input" type="checkbox" role="switch" checked>
                                <label asp-for="IsSellable" class="form-check-label">Sellable</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsSerialized" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsSerialized" class="form-check-label">Track by Serial Number</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsBatchTracked" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsBatchTracked" class="form-check-label">Track by Batch/Lot</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsExpiryTracked" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="IsExpiryTracked" class="form-check-label">Track Expiry Date</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="align-middle" data-feather="arrow-left"></i> Back to List
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="align-middle" data-feather="save"></i> Save Article
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Barcode preview
        function generateBarcode(value) {
            if (value) {
                JsBarcode("#barcode-svg", value, {
                    format: "CODE128",
                    width: 2,
                    height: 50,
                    displayValue: true,
                    fontSize: 14,
                    margin: 10
                });
            } else {
                $("#barcode-svg").empty();
            }
        }

        // Initialize barcode preview
        $(document).ready(function() {
            var initialBarcode = $('#PrimaryBarcode').val();
            generateBarcode(initialBarcode);

            // Update preview when barcode changes
            $('#PrimaryBarcode').on('input', function() {
                generateBarcode($(this).val());
            });
        });

        // Add additional barcode field
        function addBarcodeField() {
            var index = Date.now();
            var html = `
                <div class="input-group mb-2 barcode-field">
                    <input name="AdditionalBarcodes" class="form-control" placeholder="Enter additional barcode" />
                    <button type="button" class="btn btn-outline-danger" onclick="removeBarcodeField(this)">
                        <i class="align-middle" data-feather="x"></i>
                    </button>
                </div>
            `;
            $('#barcodes-list').append(html);
            feather.replace();
        }

        // Remove barcode field
        function removeBarcodeField(btn) {
            $(btn).closest('.barcode-field').remove();
        }
    </script>
}