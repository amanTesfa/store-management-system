@model SalesOrderIndexViewModel

@{
    ViewData["Title"] = "Sales Orders";
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 d-inline align-middle">Sales Orders</h1>
        <span class="badge bg-dark text-white ms-2">Sales</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="align-middle" data-feather="plus"></i> New Sales Order
    </a>
</div>

<div class="card">
    <div class="card-header">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by SO # or Customer..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select id="statusFilter" class="form-select" asp-items="Model.Statuses"></select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" id="searchBtn">
                    <i class="align-middle" data-feather="search"></i> Search
                </button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive table-scrollable">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>SO #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Delivery Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Shipping Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.SalesOrders.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="align-middle" data-feather="shopping-bag" style="width: 48px; height: 48px;"></i>
                                <p class="mt-2 mb-0">No sales orders found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var so in Model.SalesOrders)
                        {
                            var shippingPercent = so.ItemCount > 0 ? (so.ShippedCount / (float)so.ItemCount * 100) : 0;
                            <tr>
                                <td><code>@so.VoucherNumber</code></td>
                                <td><strong>@so.CustomerName</strong></td>
                                <td><span>@so.VoucherDate.ToString("yyyy-MM-dd")</span></td>
                                <td><span>@(so.DeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                                <td><span>  @so.TotalAmount.ToString("C")</span></td>
                                <td><span class="badge bg-@so.StatusClass">@so.Status</span></td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-info" role="progressbar" style="width: @shippingPercent%">
                                            @so.ShippedCount/@so.ItemCount
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@so.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="align-middle" data-feather="eye"></i>
                                        </a>
                                        @if (so.Status == "Draft")
                                        {
                                            <a asp-action="Edit" asp-route-id="@so.Id" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="align-middle" data-feather="edit-2"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-success" onclick="approveSO(@so.Id)" title="Approve">
                                                <i class="align-middle" data-feather="check-circle"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="cancelSO(@so.Id)" title="Cancel">
                                                <i class="align-middle" data-feather="x-circle"></i>
                                            </button>
                                        }
                                        @if (so.Status == "Approved")
                                        {
                                            <button type="button" class="btn btn-sm btn-primary" onclick="shipSO(@so.Id)" title="Mark as Shipped">
                                                <i class="align-middle" data-feather="truck"></i>
                                            </button>
                                            <a asp-controller="Invoices" asp-action="Create" asp-route-soId="@so.Id" class="btn btn-sm btn-success" title="Generate Invoice">
                                                <i class="align-middle" data-feather="file-text"></i>
                                            </a>
                                        }
                                        @if (so.Status == "Shipped")
                                        {
                                            <button type="button" class="btn btn-sm btn-success" onclick="completeSO(@so.Id)" title="Complete Order">
                                                <i class="align-middle" data-feather="check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between">
            <small>Page @Model.CurrentPage of @Model.TotalPages</small>
            <div>
                <button class="btn btn-sm btn-outline-secondary" onclick="previousPage()" disabled="@(Model.CurrentPage <= 1)">Previous</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="nextPage()" disabled="@(Model.CurrentPage >= Model.TotalPages)">Next</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var currentPage = @Model.CurrentPage;
        var searchTerm = '@Model.SearchTerm';
        var status = '@Model.Status';

        function refreshPage() {
            var url = '@Url.Action("Index", "SalesOrders")?searchTerm=' + encodeURIComponent(searchTerm) + '&status=' + encodeURIComponent(status) + '&page=' + currentPage;
            window.location.href = url;
        }

        function previousPage() { if (currentPage > 1) { currentPage--; refreshPage(); } }
        function nextPage() { currentPage++; refreshPage(); }

        $('#searchBtn').on('click', function() { searchTerm = $('#searchInput').val(); status = $('#statusFilter').val(); currentPage = 1; refreshPage(); });
        $('#searchInput').on('keypress', function(e) { if (e.which === 13) { searchTerm = $(this).val(); status = $('#statusFilter').val(); currentPage = 1; refreshPage(); } });
        $('#statusFilter').on('change', function() { status = $(this).val(); currentPage = 1; refreshPage(); });
        function approveSO(id) {
            showConfirm('Approve this sales order? This will reserve stock.', function() {
                $('#loadingSpinner').fadeIn(200);

                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Approve", "SalesOrders")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) {
                            showToast('success', response.message);
                            refreshPage();
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $('#loadingSpinner').fadeOut(200);
                        showToast('error', 'An error occurred. Please try again.');
                    }
                });
            });
        }

                function shipSO(id) {
            showConfirm('Mark this sales order as shipped? This will update the order status.', function() {
                $('#loadingSpinner').fadeIn(200);

                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Ship", "SalesOrders")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) {
                            showToast('success', response.message);
                            refreshPage();
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $('#loadingSpinner').fadeOut(200);
                        showToast('error', 'An error occurred. Please try again.');
                    }
                });
            });
        }

              function completeSO(id) {
            showConfirm('Complete this sales order? This will update stock levels and finalize the order.', function() {
                $('#loadingSpinner').fadeIn(200);

                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("Complete", "SalesOrders")',
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: token },
                    success: function(response) {
                        $('#loadingSpinner').fadeOut(200);
                        if (response.success) {
                            showToast('success', response.message);
                            refreshPage();
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        $('#loadingSpinner').fadeOut(200);
                        showToast('error', 'An error occurred. Please try again.');
                    }
                });
            });
        }


        function cancelSO(id) {
            showConfirm('Cancel this sales order? This action cannot be undone.', function() {
                $('#loadingSpinner').fadeIn(200);

                var reason = prompt('Enter cancellation reason:');
                if (reason) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '@Url.Action("Cancel", "SalesOrders")',
                        type: 'POST',
                        data: { id: id, reason: reason, __RequestVerificationToken: token },
                        success: function(response) {
                            $('#loadingSpinner').fadeOut(200);
                            if (response.success) {
                                showToast('success', response.message);
                                refreshPage();
                            } else {
                                showToast('error', response.message);
                            }
                        },
                        error: function() {
                            $('#loadingSpinner').fadeOut(200);
                            showToast('error', 'An error occurred. Please try again.');
                        }
                    });
                } else {
                    $('#loadingSpinner').fadeOut(200);
                }
            });
        }

              function showToast(type, message) {
            var bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            var icon = type === 'success' ? 'check-circle' : 'alert-circle';
            var toastHtml = `<div class="toast align-items-center text-white ${bgClass} border-0 position-fixed bottom-0 end-0 m-3" style="z-index: 1100;"><div class="d-flex"><div class="toast-body"><i class="align-middle me-2" data-feather="${icon}"></i>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last());
            toast.show();
            setTimeout(() => { $('.toast').last().remove(); }, 3000);
        }
    </script>
}